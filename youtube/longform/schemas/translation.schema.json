{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manylangs.studio/schemas/longform/translation.schema.json",
  "title": "ManyLangs Longform Translation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "episode_id",
    "scene_id",
    "source_language",
    "translation_language",
    "source_dialogue",
    "lines",
    "validation"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_version",
        "revision",
        "generated_by"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "2.0"
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "generated_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "provider",
            "model"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ai",
                "human"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "source_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "pt",
        "jp",
        "kr",
        "zh",
        "ru"
      ]
    },
    "translation_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "pt",
        "jp",
        "kr",
        "zh",
        "ru"
      ]
    },
    "source_dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_scene_id",
        "source_line_ids"
      ],
      "properties": {
        "source_scene_id": {
          "type": "string",
          "pattern": "^S[0-9]{3}$"
        },
        "source_line_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^L[0-9]{3}$"
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "sequence",
          "speaker",
          "source_text",
          "translated_text"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^L[0-9]{3}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "speaker": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "source_text": {
            "type": "string",
            "minLength": 1
          },
          "translated_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_line_count",
        "actual_line_count",
        "line_ids_match_source",
        "speaker_order_preserved",
        "source_text_preserved",
        "translation_complete"
      ],
      "properties": {
        "expected_line_count": {
          "type": "integer",
          "minimum": 1
        },
        "actual_line_count": {
          "type": "integer",
          "minimum": 1
        },
        "line_ids_match_source": {
          "type": "boolean"
        },
        "speaker_order_preserved": {
          "type": "boolean"
        },
        "source_text_preserved": {
          "type": "boolean"
        },
        "translation_complete": {
          "type": "boolean"
        }
      }
    }
  }
}
