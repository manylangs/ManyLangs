{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manylangs.studio/schemas/longform/master_script.schema.json",
  "title": "ManyLangs Longform Master Script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "episode_id",
    "series_id",
    "protagonist_ref",
    "scene_count",
    "scenes"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_version",
        "revision",
        "generated_by"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "2.0"
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "generated_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "provider",
            "model"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ai",
                "human",
                "hybrid"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "protagonist_ref": {
      "type": "string",
      "pattern": "^CHAR_[A-Z0-9_]+_[0-9]{3}$"
    },
    "scene_count": {
      "type": "integer",
      "const": 20
    },
    "scenes": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "sequence",
          "location_ref",
          "story_function",
          "scene_goal",
          "situation",
          "problem",
          "surprise",
          "monologue",
          "b_gender",
          "line_count",
          "protagonist_state",
          "must_happen",
          "must_not_happen",
          "dialogue_goal",
          "learning_opportunities",
          "continuity"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^S[0-9]{3}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "location_ref": {
            "type": "string",
            "pattern": "^LOC_[A-Z0-9_]+_[0-9]{3}$"
          },
          "story_function": {
            "type": "string",
            "enum": [
              "setup",
              "progress",
              "interaction",
              "observation",
              "complication",
              "response",
              "resolution",
              "transition",
              "closing"
            ]
          },
          "scene_goal": {
            "type": "string",
            "minLength": 1
          },
          "situation": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "surprise": {
            "type": "boolean"
          },
          "monologue": {
            "type": "boolean"
          },
          "b_gender": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "female",
              "male",
              null
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          },
          "protagonist_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "emotion_before",
              "emotion_after",
              "knowledge_before",
              "knowledge_after"
            ],
            "properties": {
              "emotion_before": {
                "type": "string",
                "minLength": 1
              },
              "emotion_after": {
                "type": "string",
                "minLength": 1
              },
              "knowledge_before": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "knowledge_after": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "must_happen": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "must_not_happen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dialogue_goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "learning_opportunities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "function",
                "context"
              ],
              "properties": {
                "function": {
                  "type": "string",
                  "minLength": 1
                },
                "context": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "continuity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "carry_in",
              "carry_out",
              "unresolved_before",
              "unresolved_after"
            ],
            "properties": {
              "carry_in": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "carry_out": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unresolved_before": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unresolved_after": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
