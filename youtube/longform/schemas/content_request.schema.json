{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manylangs.studio/schemas/longform/content_request.schema.json",
  "title": "ManyLangs Longform Content Request",
  "description": "Provider-neutral top-level request for generating a ManyLangs longform series or episode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "category",
    "genre",
    "topic",
    "target_language",
    "cefr_level",
    "episode",
    "reality_context"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_version",
        "revision"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "target_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "pt",
        "jp",
        "kr",
        "zh",
        "ru"
      ]
    },
    "cefr_level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_number",
        "scene_count"
      ],
      "properties": {
        "episode_number": {
          "type": "integer",
          "minimum": 1
        },
        "scene_count": {
          "const": 20
        }
      }
    },
    "tone": {
      "type": [
        "string",
        "null"
      ]
    },
    "setting": {
      "type": [
        "string",
        "null"
      ]
    },
    "reality_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_date"
      ],
      "properties": {
        "reference_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        }
      }
    },
    "protagonist_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "female",
            "male",
            null
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
