{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manylangs.studio/schemas/longform/episode.schema.json",
  "title": "ManyLangs Longform Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "episode_id",
    "series_id",
    "episode_number",
    "story",
    "language_context",
    "reality_contract",
    "continuity"
  ],
  "properties": {
    "metadata": {
      "$ref": "common.schema.json#/$defs/document_metadata"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "episode_number": {
      "type": "integer",
      "minimum": 1
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "situation",
        "summary",
        "scene_count"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scene_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "language_context": {
      "$ref": "common.schema.json#/$defs/language_context"
    },
    "reality_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reference_date",
        "location_context",
        "rules",
        "uncertain_fact_policy"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "real_world"
          ]
        },
        "reference_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "location_context": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "do_not_invent_operational_facts",
            "do_not_invent_prices",
            "do_not_invent_routes",
            "do_not_invent_payment_methods",
            "do_not_invent_schedules",
            "do_not_invent_named_services"
          ],
          "properties": {
            "do_not_invent_operational_facts": {
              "type": "boolean",
              "const": true
            },
            "do_not_invent_prices": {
              "type": "boolean",
              "const": true
            },
            "do_not_invent_routes": {
              "type": "boolean",
              "const": true
            },
            "do_not_invent_payment_methods": {
              "type": "boolean",
              "const": true
            },
            "do_not_invent_schedules": {
              "type": "boolean",
              "const": true
            },
            "do_not_invent_named_services": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "uncertain_fact_policy": {
          "type": "string",
          "enum": [
            "generalize_or_flag"
          ]
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_refs",
        "location_refs",
        "previous_episode_id",
        "next_episode_id"
      ],
      "properties": {
        "character_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHAR_[A-Z0-9_]+_[0-9]{3}$"
          }
        },
        "location_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^LOC_[A-Z0-9_]+_[0-9]{3}$"
          }
        },
        "previous_episode_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
        },
        "next_episode_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
        },
        "carry_in_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "carry_out_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
