{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manylangs.studio/schemas/longform/learning.schema.json",
  "title": "ManyLangs Longform Learning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "episode_id",
    "scene_id",
    "target_language",
    "cefr_level",
    "source_dialogue",
    "key_expressions",
    "validation"
  ],
  "properties": {
    "metadata": {
      "$ref": "common.schema.json#/$defs/document_metadata"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "target_language": {
      "$ref": "common.schema.json#/$defs/internal_language_code"
    },
    "cefr_level": {
      "$ref": "common.schema.json#/$defs/cefr_level"
    },
    "source_dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_scene_id",
        "source_line_ids"
      ],
      "properties": {
        "source_scene_id": {
          "type": "string",
          "pattern": "^S[0-9]{3}$"
        },
        "source_line_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^L[0-9]{3}$"
          }
        }
      }
    },
    "key_expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_expression_id",
          "source_line_ids",
          "expression",
          "meaning",
          "usage",
          "context",
          "communicative_function",
          "difficulty",
          "priority",
          "review"
        ],
        "properties": {
          "key_expression_id": {
            "type": "string",
            "pattern": "^KE[0-9]{3}$"
          },
          "source_line_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{3}$"
            }
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "communicative_function": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "core",
              "useful",
              "optional"
            ]
          },
          "variation": {
            "type": [
              "string",
              "null"
            ]
          },
          "common_mistake": {
            "type": [
              "string",
              "null"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "should_review",
              "review_reason"
            ],
            "properties": {
              "should_review": {
                "type": "boolean"
              },
              "review_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression_count",
        "all_expressions_exist_in_dialogue",
        "source_lines_valid",
        "cefr_appropriate"
      ],
      "properties": {
        "expression_count": {
          "type": "integer",
          "minimum": 0
        },
        "all_expressions_exist_in_dialogue": {
          "type": "boolean"
        },
        "source_lines_valid": {
          "type": "boolean"
        },
        "cefr_appropriate": {
          "type": "boolean"
        }
      }
    }
  }
}
