{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manylangs.studio/schemas/longform/dialogue.schema.json",
  "title": "ManyLangs Longform Dialogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "episode_id",
    "scene_id",
    "target_language",
    "cefr_level",
    "mode",
    "protagonist_ref",
    "b_gender",
    "lines",
    "scene_state",
    "validation"
  ],
  "properties": {
    "metadata": {
      "$ref": "common.schema.json#/$defs/document_metadata"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_ep[0-9]{3}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "target_language": {
      "$ref": "common.schema.json#/$defs/internal_language_code"
    },
    "cefr_level": {
      "$ref": "common.schema.json#/$defs/cefr_level"
    },
    "mode": {
      "type": "string",
      "enum": [
        "monologue",
        "dialogue"
      ]
    },
    "protagonist_ref": {
      "type": "string",
      "pattern": "^CHAR_[A-Z0-9_]+_[0-9]{3}$"
    },
    "b_gender": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "female",
        "male",
        null
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "sequence",
          "speaker",
          "text"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^L[0-9]{3}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "speaker": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "character_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CHAR_[A-Z0-9_]+_[0-9]{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "communicative_function": {
            "type": "string",
            "minLength": 1
          },
          "emotion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scene_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_ref",
        "carry_in",
        "carry_out",
        "emotion"
      ],
      "properties": {
        "location_ref": {
          "type": "string",
          "pattern": "^LOC_[A-Z0-9_]+_[0-9]{3}$"
        },
        "carry_in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "carry_out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_line_count",
        "actual_line_count"
      ],
      "properties": {
        "expected_line_count": {
          "type": "integer",
          "minimum": 1
        },
        "actual_line_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
