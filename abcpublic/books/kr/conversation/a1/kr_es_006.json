      "dialogue_layer": {
        "A": [
          "Con el envoltorio de regalo, ¿cuánto sería?",
          "Oh, la tarifa de envoltorio es más barata de lo que pensé.",
          "De acuerdo, envuélvalo por favor."
        ],
        "B": [
          "Con el envoltorio, serían 12.000 won.",
          "Sí, el envoltorio cuesta solo 1.000 won.",
