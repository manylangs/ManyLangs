      "sentences": {
        "target": "문제는 드러나는 법이다.",
        "en": "",
        "es": "",
        "fr": "",
        "pt": "Os problemas tendem a revelar-se."
      }
    },
    {
      "type": "grammar_example",
      "variant": "core_patterns",
      "sentences": {
        "target": "습관은 쉽게 바뀌지 않는 법이다.",
        "en": "",
        "es": "",
        "fr": "",
        "pt": "Os hábitos não mudam facilmente."
