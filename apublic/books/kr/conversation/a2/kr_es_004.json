  "voice_validation_required": true,
  "key_expressions": [
    "¿Tienes tiempo?,",
    "¿Hacemos una cita?,",
    "¿Qué tal esta semana?,",
    "¡Esa hora me viene bien!,",
    "Recuérdame la fecha, por favor.,"
