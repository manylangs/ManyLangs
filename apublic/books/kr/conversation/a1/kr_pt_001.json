  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "Olá! Como te sentes hoje?",
          "Ah, percebo. Eu estou bem.",
          "Ótimo! Tem um bom dia."
        ],
        "B": [
          "Olá! Estou um pouco cansado, mas estou bem.",
          "Ainda bem. Força!",
          "Obrigado!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "Olá! Tens um minuto?",
          "Perfeito, podemos falar um bocadinho.",
          "Então vamos caminhar um pouco juntos."
        ],
        "B": [
          "Olá! Sim, tenho. O que se passa?",
          "Ótimo! Eu também estou livre.",
          "Está bem, vamos!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "Olá! Pareces um pouco ocupado hoje.",
          "Entendo. Eu também estou um pouco cansada.",
          "Bom, espero que o teu dia corra bem!"
        ],
        "B": [
          "Olá! Sim, tenho muito para fazer.",
          "Pois é. Toda a gente anda ocupada.",
          "Sim! Obrigado."
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "Olá! O tempo não está ótimo hoje?",
          "Sim, isso deixa-me bem-disposta.",
          "Fico feliz por te ver num dia assim!"
        ],
        "B": [
          "Sim, está muito agradável!",
          "Também acho. O sol sabe mesmo bem.",
          "Também é bom ver-te!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "Ei! Vais a algum lado?",
          "Perfeito, eu também vou por aí.",
          "Então vamos juntos!"
        ],
        "B": [
          "Sim! Vou para a paragem de autocarro.",
          "A sério? Que coincidência boa!",
          "Está bem, vamos juntos!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "Olá! Já almoçaste?",
          "Oh, parece saboroso. Eu ainda não comi.",
          "Bem, eu também devia comer alguma coisa."
        ],
        "B": [
          "Sim, comi algo simples.",
          "Se quiseres, podemos comer juntos.",
          "Perfeito! Bom apetite!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "Olá! Estás com bom humor hoje!",
          "Que ótimo! Fico contente por ti.",
          "Bem, tem um excelente dia!"
        ],
        "B": [
          "Sim! Aconteceu-me algo bom.",
          "Obrigado! Sinto-me muito bem.",
          "Obrigado! Igualmente."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "Olá! Dormiste bem esta noite?",
          "Ah, entendo. Por isso pareces um pouco cansado.",
          "Espero que consigas descansar cedo hoje."
        ],
        "B": [
          "Hmm... não muito. Dormi pouco.",
          "Sim, dormi mal esta noite.",
          "Sim, tens razão. Obrigado pelo conselho!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "Ei! Para onde vais hoje?",
          "Ah, percebo. Eu estou só a dar um passeio.",
          "Está bem, até à próxima!"
        ],
        "B": [
          "Olá! Vou encontrar-me com alguém.",
          "Um passeio? Que inveja!",
          "Sim! Até logo!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "Olá! Estás bem hoje?",
          "Sim, acontece. Eu estou normal.",
          "Bem, força para hoje!"
        ],
        "B": [
          "Hmm... sinto-me um pouco estranho.",
          "Ah é? Pareces bem!",
          "Obrigado! Vou fazer o meu melhor."
        ]
      }
    }
  ]
