        "es": "",
        "fr": "",
        "pt": ""
      }
    },
    {
      "type": "grammar_example",
      "variant": "core_patterns",
      "sentences": {
        "target": "이쪽으로 오십시오. (십시오체)",
        "en": "Please come this way. (십시오-style)",
        "es": "",
        "fr": "",
        "pt": ""
      }
    },
    {
