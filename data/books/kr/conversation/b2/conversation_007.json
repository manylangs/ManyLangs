{
  "chapter_id": "007",
  "cefr": "B2",
  "title_kr": "맛집 찾기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "근처에 맛집 있나요?,",
    "추천해주실 곳 있나요?,",
    "예약이 필요할까요?,",
    "웨이팅이 긴가요?,",
    "가격대는 어떤가요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "혹시 이 근처에 맛있는 식당 아세요?",
          "오 분위기 좋은 곳이면 더 좋죠!",
          "그럼 그 집으로 가볼까요?"
        ],
        "B": [
          "응, 바로 골목 건너에 꽤 유명한 집 있어.",
          "거기 인테리어도 예쁘고 음식도 괜찮아.",
          "좋아! 가면서 메뉴도 한번 찾아보자."
        ]
      }
    },
    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 추천해줄 만한 음식 있어?",
          "와, 비주얼부터 맛있겠다!",
          "그럼 그 메뉴로 먹어볼게."
        ],
        "B": [
          "응, 그 집 파스타가 진짜 잘 나와.",
          "맞아, 나오면 사진 먼저 찍게 돼.",
          "좋아! 양도 꽤 넉넉해서 만족할 거야."
        ]
      }
    },
    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "혹시 예약해야 되는 곳이야?",
          "아 그렇구나! 그 정도면 괜찮네.",
          "너 도착 시간 맞춰서 가면 되겠다."
        ],
        "B": [
          "평일은 괜찮은데 주말엔 예약하는 게 좋아.",
          "응, 그래도 웨이팅 엄청 길진 않아.",
          "그래! 너무 늦지만 않으면 바로 들어갈 수 있을 거야."
        ]
      }
    },
    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 웨이팅이 긴 편이야?",
          "오 생각보다 괜찮네.",
          "그럼 우리 그냥 기다리자!"
        ],
        "B": [
          "시간대마다 다른데 점심 피크만 좀 길어.",
          "응, 십에서 십오분 정도면 대부분 들어가.",
          "좋아! 기다리면서 메뉴 고르자."
        ]
      }
    },
    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "가격대는 어떤 느낌이야?",
          "오, 분위기 생각하면 괜찮다!",
          "그럼 크게 부담은 없겠네."
        ],
        "B": [
          "메뉴마다 다르지만 중간 정도야.",
          "응, 가성비 좋다는 평이 많아.",
          "맞아! 양도 넉넉해서 만족도 높아."
        ]
      }
    },
    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "혹시 디저트도 괜찮아?",
          "와, 그런 스타일 좋아해!",
          "그럼 식사 끝나고 꼭 먹어야겠다."
        ],
        "B": [
          "응, 티라미수가 특히 유명해.",
          "달지 않고 부드러워서 다들 좋아해.",
          "좋아! 배부르더라도 디저트는 별도니까."
        ]
      }
    },
    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 혼자 가도 괜찮은 분위기야?",
          "아 그런 아늑한 느낌 좋다!",
          "그럼 혼밥도 부담 없겠네."
        ],
        "B": [
          "응, 일인석도 있어서 편해.",
          "전체적으로 조용하고 따뜻한 분위기야.",
          "맞아! 혼자 가도 전혀 어색하지 않아."
        ]
      }
    },
    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "채식 메뉴도 있을까?",
          "오 그 정도면 고를 수 있겠다.",
          "그럼 친구랑 같이 가도 좋겠네."
        ],
        "B": [
          "응, 샐러드나 채식 파스타 몇 가지 있어.",
          "완전 비건은 아니지만 선택지는 있어.",
          "맞아! 식성 달라도 무난하게 맞출 수 있어."
        ]
      }
    },
    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "여기 근처에 조용한 식당도 있어?",
          "오 그런 분위기 괜찮다!",
          "그럼 거기서 얘기하면서 천천히 먹자."
        ],
        "B": [
          "응, 조금만 걸으면 분위기 차분한 곳 하나 있어.",
          "사람도 많지 않아서 편하게 먹기 좋아.",
          "좋아! 자리 넓어서 오래 있어도 괜찮아."
        ]
      }
    },
    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "그럼 이제 어디로 갈지 정해볼까?",
          "오 두 곳 다 좋아 보이네!",
          "그럼 네가 가고 싶은 곳으로 결정하자."
        ],
        "B": [
          "그래! 후보가 두 군데니까 고르기 쉽겠다.",
          "응 분위기도 다르고 메뉴도 달라서 선택 폭 넓어.",
          "좋아! 내가 한 군데 선택해서 안내할게."
        ]
      }
    }
  ]
}
