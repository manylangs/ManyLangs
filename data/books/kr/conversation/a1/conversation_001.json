{
  "chapter_id": "001",
  "cefr": "A1",
  "title_kr": "인사하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "안녕하세요?",
    "잘 지내요?",
    "오랜만이에요!",
    "반가워요!",
    "오늘 어때요?"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "안녕하세요? 오늘 기분 어때요?",
          "아, 그렇군요! 저는 괜찮아요.",
          "좋아요! 그럼 오늘도 좋은 하루 보내세요."
        ],
        "B": [
          "안녕하세요! 오늘은 좀 피곤하지만 괜찮아요.",
          "다행이에요. 그래도 힘내요!",
          "네, 감사합니다!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 지금 잠깐 시간 있어요?",
          "좋아요, 잠깐 얘기좀 해요.",
          "그럼 잠시만 같이 걸어요!"
        ],
        "B": [
          "안녕하세요! 있어요, 무슨 일이에요?",
          "오, 좋아요! 저도 시간 돼요.",
          "좋아요, 가요!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 오늘은 좀 바빠 보여요.",
          "그렇군요, 저도 오늘 일찍 일어나서 좀 피곤해요.",
          "그래도 오늘 잘 보내요!"
        ],
        "B": [
          "안녕하세요! 네, 일이 조금 많아요.",
          "아, 공감돼요. 요즘 다들 바쁘죠.",
          "네! 고마워요!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 오늘 날씨 좋지 않아요?",
          "맞아요, 그래서 기분도 좋아졌어요.",
          "좋은 날에 이렇게 보니 더 반가워요!"
        ],
        "B": [
          "맞아요! 너무 좋네요.",
          "저도 그래요. 햇볕이 따뜻해서 좋아요.",
          "저도 반가워요!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 혹시 지금 이동 중이에요?",
          "좋아요, 저도 그쪽으로 가는 중이에요.",
          "그럼 같이 가요!"
        ],
        "B": [
          "네! 버스 정류장으로 가고 있어요.",
          "오, 진짜요? 타이밍 좋네요!",
          "좋아요, 같이 가요!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 오늘 점심은 드셨어요?",
          "오, 맛있겠다! 저는 아직 못 먹었어요.",
          "좋아요! 그럼 저도 얼른 먹어야겠네요!"
        ],
        "B": [
          "네! 간단하게 먹었어요.",
          "시간 되면 같이 먹을래요?",
          "그래요! 맛있게 드세요!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 오늘 좀 밝아 보여요?",
          "와, 좋은 소식이네요! 들으니 저도 기뻐요.",
          "그럼 오늘도 좋은 하루 보내요!"
        ],
        "B": [
          "맞아요! 좋은 일이 좀 있었어요.",
          "고마워요! 기분 좋네요.",
          "네! 감사합니다."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 혹시 어젯밤에 잠은 잘 잤어요?",
          "아하, 그래서 조금 피곤해 보였군요.",
          "오늘은 일찍 쉬면 좋겠어요!"
        ],
        "B": [
          "음… 조금 부족하게 잤어요.",
          "맞아요. 잠을 오래 못 잤어요.",
          "네, 그래야겠어요. 조언 고마워요!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 오늘은 어디 가는 길이에요?",
          "오, 그렇군요! 저는 그냥 산책 중이에요.",
          "그럼 다음에 또 봐요!"
        ],
        "B": [
          "안녕하세요! 약속이 있어서 가는 중이에요.",
          "산책이라니 부럽네요!",
          "네! 또 봬요!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 오늘은 컨디션 괜찮아요?",
          "그런 날도 있죠. 저는 그냥 평범해요.",
          "오늘도 파이팅이에요!"
        ],
        "B": [
          "음… 조금 멍한 느낌이에요.",
          "아, 그래요? 그래도 괜찮아 보이네요!",
          "고마워요! 힘낼게요."
        ]
      }
    }
  ]
}
