  "title_es": "Saludos",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "¡Hola!",
    "¿Cómo estás?",
    "¡Cuánto tiempo!",
    "¡Qué gusto verte!",
    "¿Cómo va tu día?"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¿Cómo te sientes hoy?",
          "Ah, ya veo. Yo estoy bien.",
          "¡Genial! Que tengas un buen día."
        ],
        "B": [
          "¡Hola! Estoy un poco cansado, pero bien.",
          "Me alegra oír eso. ¡Ánimo!",
          "¡Gracias!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¿Tienes un minuto?",
          "Perfecto, podemos hablar un rato.",
          "Entonces, caminemos un momento juntos."
        ],
        "B": [
          "¡Hola! Sí, tengo un momento. ¿Qué pasa?",
          "¡Genial! Yo también estoy libre.",
          "Vale, ¡vamos!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "¡Hola! Hoy pareces un poco ocupado.",
          "Te entiendo. Yo también estoy algo cansada.",
          "Bueno, ¡espero que tengas un buen día!"
        ],
        "B": [
          "¡Hola! Sí, tengo bastante trabajo.",
          "Sí, es verdad. Todos están ocupados últimamente.",
          "¡Sí! Gracias."
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¿No está muy agradable el clima hoy?",
          "Sí, me pone de buen humor.",
          "¡Me alegra verte en un día tan bonito!"
        ],
        "B": [
          "Sí, está muy agradable.",
          "A mí también. El sol se siente muy bien.",
          "¡Yo también me alegro de verte!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "¡Hey! ¿Vas a algún lugar?",
          "Perfecto, yo voy para allá también.",
          "Entonces, ¡vamos juntos!"
        ],
        "B": [
          "Sí, voy hacia la parada del bus.",
          "¿En serio? ¡Qué buena coincidencia!",
          "Vale, ¡vamos juntos!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¿Ya almorzaste?",
          "Oh, suena rico. Yo todavía no he comido.",
          "Bien, yo también debería comer algo."
        ],
        "B": [
          "Sí, comí algo sencillo.",
          "Si quieres, ¿comemos juntos?",
          "¡Perfecto! ¡Buen provecho!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¡Hoy te ves de buen humor!",
          "Qué bien, ¡me alegro mucho por ti!",
          "Bueno, ¡que tengas un excelente día!"
        ],
        "B": [
          "¡Sí! Me pasó algo bueno.",
          "¡Gracias! Me siento muy bien.",
          "¡Gracias! Igualmente."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¿Dormiste bien anoche?",
          "Ah, entiendo. Por eso te ves un poco cansado.",
          "Espero que puedas descansar temprano hoy."
        ],
        "B": [
          "Hmm… no mucho. Dormí poco.",
          "Sí, tuve una mala noche.",
          "Sí, tienes razón. ¡Gracias por el consejo!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "¡Hey! ¿A dónde vas hoy?",
          "Ah, ya veo. Yo solo estoy dando un paseo.",
          "Bueno, ¡nos vemos luego!"
        ],
        "B": [
          "¡Hola! Voy a encontrarme con alguien.",
          "Un paseo, ¡qué bien! Qué envidia.",
          "¡Sí! ¡Hasta luego!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "¡Hola! ¿Te sientes bien hoy?",
          "Sí, pasa a veces. Yo estoy normal.",
          "Bueno, ¡ánimo para hoy!"
        ],
        "B": [
          "Hmm… me siento un poco raro.",
          "¿Ah sí? ¡Pues te ves bien!",
          "¡Gracias! Haré lo mejor que pueda."
        ]
      }
    }
  ]
}
