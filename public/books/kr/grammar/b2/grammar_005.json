        "es": "",
        "fr": "",
        "pt": ""
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "본래 의미보다 가볍게 말하거나 책임을 줄여 표현할 때 쓰기도 한다.",
