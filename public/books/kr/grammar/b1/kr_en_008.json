    },
    {
      "type": "grammar_example",
      "variant": "extended_usage",
      "sentences": {
        "target": "그가 요즘 괜찮냐고 조심스럽게 물어봤어.",
        "en": "He carefully asked if I was doing okay lately.",
        "es": "",
