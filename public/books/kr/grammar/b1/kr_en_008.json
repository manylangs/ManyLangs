    },
    {
      "type": "grammar_example",
      "variant": "extended_usage",
      "sentences": {
        "target": "그는 왜 갑자기 결정했냐고 했어.",
        "en": "He asked why I made the decision suddenly.",
        "es": "",
        "fr": "",
        "pt": ""
      }
    },
    {
      "type": "grammar_example",
      "variant": "extended_usage",
      "sentences": {
        "target": "언제 다시 만날 거냐고 친구들이 물어봤어.",
        "en": "My friends asked when we would meet again.",
        "es": "",
