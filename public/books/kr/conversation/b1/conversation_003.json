{
  "chapter_id": "003",
  "cefr": "B1",
  "title_kr": "교수님 상담",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "상담 가능하세요?,",
    "과제 관련해서 여쭤보고 싶어요,",
    "설명이 조금 헷갈렸어요,",
    "진로 상담도 가능할까요?,",
    "시간 괜찮으세요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "교수님, 지금 잠깐 상담 가능하실까요?",
          "오늘 과제 설명 중에 잘 이해가 안 된 부분이 있었어요.",
          "혹시 다시 간단히 말씀해주실 수 있을까요?"
        ],
        "B": [
          "아, 물론이죠! 어떤 부분이 헷갈렸나요?",
          "그 부분은 학생들이 자주 질문하는 내용이에요.",
          "천천히 다시 설명해드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "보고서 구성 방식이 여전히 조금 어렵게 느껴져요.",
          "특히 어떤 순서로 써야 할지 잘 모르겠어요.",
          "예시가 있다면 더 이해가 쉬울 것 같아요."
        ],
        "B": [
          "그럴 수 있어요, 처음엔 헷갈릴 수 있죠.",
          "구성은 크게 서론–본론–결론 흐름만 잡으면 돼요.",
          "예시 자료는 수업 게시판에 올려둘게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "혹시 제 발표 주제 방향이 괜찮은지도 여쭤보고 싶어요.",
          "조금 범위가 넓은 건 아닌지 걱정돼서요.",
          "수정이 필요하면 바로 조정해보려고요."
        ],
        "B": [
          "주제는 좋아요! 너무 넓지도 않고 적당해요.",
          "다만 사례를 두세 개로 줄이면 더 명확해질 거예요.",
          "그렇게만 조정하면 충분히 좋은 발표가 될 거예요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "지난 시험에서 틀린 문제들을 다시 보고 싶은데 가능할까요?",
          "제가 어디서 실수했는지 정확히 알고 싶어요.",
          "피드백 주시면 다음에 더 잘할 수 있을 것 같아요."
        ],
        "B": [
          "좋아요, 틀린 문제 분석은 정말 도움이 돼요.",
          "대부분은 개념을 조금만 보완하면 해결될 것들이에요.",
          "잠시만요, 시험지 가지고 올게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 이번 주 안에 따로 상담 시간 잡을 수 있을까요?",
          "과제 말고도 전공 관련해서 여쭤보고 싶은 게 있어요.",
          "시간 괜찮으신 날로 맞춰볼게요."
        ],
        "B": [
          "좋아요, 이번 주 수요일 오후는 괜찮아요.",
          "전공 상담은 미리 준비해오면 더 좋아요.",
          "학생 일정에 맞춰도 되니까 편한 시간 알려주세요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "교수님 발표 피드백 정말 도움 됐어요.",
          "말씀해주신 부분 수정하니까 훨씬 자연스러워졌어요.",
          "혹시 마지막으로 한 번만 더 봐주실 수 있을까요?"
        ],
        "B": [
          "와, 그렇게까지 반영했다니 기쁘네요!",
          "지금 버전이면 거의 완성 수준이에요.",
          "마지막 점검은 수업 끝나고 잠깐 보면 될 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "교수님, 지난번에 추천해주신 논문 읽어봤어요.",
          "생각보다 흥미롭고 도움이 많이 됐어요.",
          "비슷한 자료 더 찾아보면 좋을 것 같아요."
        ],
        "B": [
          "오, 벌써 읽어봤군요! 대단하네요.",
          "그 논문 이해했으면 다음 자료도 어렵지 않을 거예요.",
          "원하면 추가 자료 몇 개 더 추천해줄게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "혹시 학기 후반에 있을 프로젝트 일정도 미리 알 수 있을까요?",
          "준비 기간이 얼마나 필요한지 알고 싶어요.",
          "미리 계획 세우면 덜 급할 것 같아서요."
        ],
        "B": [
          "좋은 생각이에요! 미리 계획하면 훨씬 수월해요.",
          "프로젝트는 중간고사 이후부터 시작될 거예요.",
          "세부 일정은 다음 주에 공지할 예정이에요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "교수님, 혹시 진로 상담도 가능할까요?",
          "어떤 방향으로 준비해야 할지 잘 모르겠어요.",
          "기초부터 차근차근 잡고 싶어요."
        ],
        "B": [
          "물론이죠! 진로 상담은 언제든 환영이에요.",
          "가장 중요한 건 본인이 흥미 있는 분야부터 찾는 거예요.",
          "원하면 커리큘럼 맞춤으로 정리해줄게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "오늘 상담 정말 감사해요, 교수님.",
          "말씀 듣고 나니까 마음이 훨씬 편해졌어요.",
          "말씀해주신 방향으로 차근차근 준비해볼게요."
        ],
        "B": [
          "그렇게 느꼈다니 정말 다행이에요!",
          "천천히 해도 괜찮으니까 너무 부담 갖지 마세요.",
          "필요하면 언제든 다시 찾아오면 돼요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

