{
  "chapter_id": "002",
  "cefr": "B1",
  "title_kr": "수업 듣기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "오늘 수업 어땠어요?,",
    "교수님 설명 이해됐어요?,",
    "노트 잘 따라갔어요?,",
    "다음 시간 준비됐어요?,",
    "과제는 괜찮았어요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "오늘 수업 어땠어요?",
          "저는 중간에 좀 어려운 부분이 있었어요.",
          "노트 정리하면서 다시 봐야 할 것 같아요."
        ],
        "B": [
          "생각보다 괜찮았어요!",
          "어려운 부분은 교수님 예시 들으니까 좀 이해됐어요.",
          "같이 정리하면 금방 해결될 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "오늘 배우는 내용이 지난주보다 조금 복잡했어요.",
          "특히 공식 부분이 잘 안 잡히더라고요.",
          "집에 가서 예제 더 풀어봐야겠어요."
        ],
        "B": [
          "맞아요, 공식이 갑자기 많아졌죠.",
          "예제 풀면 진짜 금방 감 잡혀요.",
          "필요하면 제가 풀었던 문제도 보여줄게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "오늘 교수님 말 속도가 조금 빨랐던 것 같아요.",
          "따라가느라 살짝 정신이 없었어요.",
          "다행히 녹음해 둬서 다시 들을 수 있을 것 같아요."
        ],
        "B": [
          "맞아요, 오늘은 특히 빨랐어요!",
          "저도 몇 문장은 놓쳤어요.",
          "녹음 있다면 다시 들으면 금방 이해될 거예요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "수업 자료가 생각보다 도움이 많이 되네요.",
          "정리도 잘 되어 있어서 보기 편해요.",
          "프린트해서 갖고 다녀야겠어요."
        ],
        "B": [
          "그쵸? 자료가 잘 만들어졌더라고요.",
          "저도 필기할 때 진짜 편했어요.",
          "프린트하면 수업 따라가기 훨씬 쉬워요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "오늘 그룹 토론 재미있지 않았어요?",
          "생각보다 다들 의견이 많던데요.",
          "저도 덕분에 개념이 더 확실해졌어요."
        ],
        "B": [
          "맞아요! 다들 적극적이었어요.",
          "서로 이야기하니까 이해가 훨씬 잘 되더라고요.",
          "토론 수업 자주 했으면 좋겠어요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "오늘 과제 설명 제대로 들었어요?",
          "저는 마지막 부분이 좀 헷갈렸어요.",
          "같이 확인해 보면 좋을 것 같아요."
        ],
        "B": [
          "저도 마지막에 살짝 놓쳤어요.",
          "요약 올려주신다니까 곧 괜찮아질 거예요.",
          "같이 보면 정확히 알 수 있을 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "오늘 수업 분위기 되게 활발했던 것 같아요.",
          "질문도 많고 반응도 좋았죠?",
          "그래서 그런지 집중도 잘 됐어요."
        ],
        "B": [
          "맞아요! 오늘 다들 에너지가 있었어요.",
          "교수님도 기분 좋아 보이시더라고요.",
          "이런 분위기면 진짜 수업 듣기 편해요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "오늘 배운 부분이 시험에 나온다고 했죠?",
          "그래서 더 신경 쓰면서 들었어요.",
          "필기도 평소보다 더 열심히 했어요."
        ],
        "B": [
          "네, 시험에 꼭 나온대요!",
          "저도 긴장하고 들었어요.",
          "필기 잘했으면 절반은 끝난 거예요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "슬라이드 색깔이 바뀐 거 보셨어요?",
          "가독성이 좋아져서 보기 편하더라고요.",
          "오늘은 내용이 더 눈에 잘 들어왔어요."
        ],
        "B": [
          "맞아요, 색이 훨씬 보기 좋아졌어요!",
          "저도 그래서 집중이 잘 됐어요.",
          "슬라이드 바뀌니까 수업 질이 확 좋아진 느낌이에요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "오늘 수업 듣고 나니까 자신감이 좀 생겼어요.",
          "이제 흐름이 어느 정도 잡힌 것 같아요.",
          "다음 시간도 괜찮게 따라갈 수 있을 것 같아요."
        ],
        "B": [
          "오, 그 말 들으니까 저도 힘 나네요!",
          "흐름 잡히면 수업이 훨씬 쉬워지죠.",
          "다음 시간도 같이 잘 해봐요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

