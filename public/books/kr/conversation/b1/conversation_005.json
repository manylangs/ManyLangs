{
  "chapter_id": "005",
  "cefr": "B1",
  "title_kr": "팀 프로젝트",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "팀 회의 언제할까요?,",
    "역할 분담 괜찮아요?,",
    "자료 찾는 건 어떻게 진행돼요?,",
    "파일 정리해둘게요,",
    "발표 준비해야겠어요,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "이번 주에 팀 회의 언제 하면 좋을까요?",
          "저는 내일 오후가 괜찮긴 한데, 다들 시간 맞을까요?",
          "혹시 다른 시간대가 더 편하면 말해 주세요."
        ],
        "B": [
          "내일 오후 좋네요! 저도 그 시간 가능해요.",
          "다른 팀원들도 아마 맞출 수 있을 것 같아요.",
          "그럼 단톡에 공지해보면 어떨까요?"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "이번 프로젝트 역할 분담은 어떻게 할까요?",
          "저는 정리나 발표 자료 만드는 건 자신 있어요.",
          "혹시 맡고 싶은 파트 있으세요?"
        ],
        "B": [
          "오, 정리 잘하신다니 정말 든든하네요!",
          "저는 자료 조사나 분석 쪽이 더 편해요.",
          "서로 맞는 부분 맡으면 더 빨리 진행될 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "자료 찾는 건 어디까지 진행됐나요?",
          "저는 관련 논문 몇 개는 모아둔 상태예요.",
          "필요하시면 지금 바로 공유드릴게요."
        ],
        "B": [
          "오, 벌써 그렇게 모으셨어요? 감사해요!",
          "저는 통계 자료 위주로 보고 있었어요.",
          "같이 합치면 자료가 훨씬 풍부해질 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "팀 공용 폴더가 조금 복잡한 것 같아요.",
          "제가 오늘 정리해서 다시 구조 만들어둘까요?",
          "이름도 한 번에 알아보기 쉽게 바꿔둘게요."
        ],
        "B": [
          "와, 그렇게 정리해주시면 정말 도움이 될 것 같아요!",
          "지금은 파일이 너무 흩어져 있어서 헷갈리더라고요.",
          "정리해주시면 저희도 작업하기 더 수월할 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "발표 준비는 언제부터 시작할까요?",
          "저는 이번 주 중반쯤 시작하면 괜찮을 것 같아요.",
          "슬라이드 틀이라도 미리 만들어둘까요?"
        ],
        "B": [
          "네, 그 일정 좋네요!",
          "틀 먼저 잡아두면 저희도 그 위에 내용 넣기 편해요.",
          "시간 되실 때 초안만 만들어주셔도 충분해요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "혹시 오늘 회의에서 이야기했던 부분 정리해두셨나요?",
          "저는 몇 가지만 메모해서 조금 불완전한 것 같아요.",
          "정리된 내용 있으면 공유 부탁드려요."
        ],
        "B": [
          "네, 회의 끝나고 바로 정리해뒀어요.",
          "중요한 결정 사항만 간단하게 정리해놨으니 확인하면 될 거예요.",
          "지금 단톡방에 바로 올려드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "과제 기준표 보니까 평가 항목이 꽤 많더라고요.",
          "특히 발표 점수가 생각보다 높아서 좀 걱정돼요.",
          "우리 발표 연습도 몇 번 해야 할 것 같아요."
        ],
        "B": [
          "맞아요, 발표 비중이 큰 편이더라고요.",
          "그래도 미리 연습해두면 충분히 잘할 수 있을 거예요.",
          "시간 맞춰서 두세 번 정도 리허설해보면 어떨까요?"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "작업 속도가 팀마다 조금 다른 것 같아요.",
          "우리 팀도 일정 좀 세분화해두면 좋을 것 같아요.",
          "일단 이번 주 목표만 정해볼까요?"
        ],
        "B": [
          "좋은 생각이에요. 목표가 있으면 진행 속도가 안정되더라고요.",
          "이번 주에 해야 할 핵심 작업만 정리해보죠.",
          "저도 생각해둔 목록이 있어서 공유드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "혹시 서로 작업한 부분 리뷰하는 시간도 정할까요?",
          "서로 피드백 주면 완성도가 좀 더 올라갈 것 같아요.",
          "주말쯤 잠깐 만나서 보면 어떨까요?"
        ],
        "B": [
          "네, 리뷰 시간 꼭 필요하다고 생각해요.",
          "주말 오전이나 오후 둘 다 괜찮아요.",
          "편한 시간 알려주시면 맞춰볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "팀 프로젝트 거의 끝나가네요!",
          "생각보다 잘 맞아서 작업이 수월했어요.",
          "마무리만 잘하면 제출도 문제 없겠죠?"
        ],
        "B": [
          "그러게요, 팀워크가 좋아서 큰 어려움 없이 진행된 것 같아요.",
          "마무리만 차분히 확인하면 충분히 좋게 나올 거예요.",
          "제출 전에 마지막으로 전체만 한번 같이 점검해요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

