{
  "chapter_id": "004",
  "cefr": "B1",
  "title_kr": "과제 및 제출",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "과제 제출했어요?,",
    "마감일 언제예요?,",
    "파일 잘 업로드됐나요?,",
    "혹시 형식 맞춰야 하나요?,",
    "제출 다시 가능해요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "혹시 과제 제출했어요?",
          "저는 업로드했는데 제대로 올라갔는지 걱정돼요.",
          "파일 이름도 맞게 썼는지 모르겠어요."
        ],
        "B": [
          "네, 저는 방금 제출했어요.",
          "업로드만 정상적으로 되면 보통 문제는 없더라고요.",
          "불안하시면 제출한 파일을 한 번 더 열어서 확인해보시는 게 좋을 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "마감일이 오늘 밤 11시 59분 맞죠?",
          "교수님이 수업 때는 다르게 말씀하셨던 것 같아서요.",
          "혹시 공지 다시 봤나요?"
        ],
        "B": [
          "네, 공지에는 정확히 11시 59분이라고 적혀 있었어요.",
          "수업 중에는 살짝 혼동될 만한 표현이 있었던 것 같아요.",
          "그래도 공식 공지가 기준이니 그 시간 맞춰 제출하시면 돼요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "파일 형식은 PDF로 제출하는 거 맞죠?",
          "저는 처음에 Word로 만들었다가 다시 변환했어요.",
          "혹시 변환하면서 깨지는 부분 없겠죠?"
        ],
        "B": [
          "네, PDF 형식 제출이 맞아요.",
          "대부분 문제는 없는데 표나 이미지가 있을 때는 간혹 깨지는 경우도 있더라고요.",
          "제출 전에 PDF 미리보기로 한 번 확인해보시면 안전해요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 참고문헌 형식 어떻게 맞췄어요?",
          "저는 APA가 맞는지 MLA가 맞는지 헷갈리더라고요.",
          "교수님이 따로 지정하셨나요?"
        ],
        "B": [
          "교수님께서 APA 형식으로 작성하라고 하셨어요.",
          "수업 첫 주 자료에 관련 안내가 있었던 걸로 기억해요.",
          "필요하시면 제가 정리해둔 예시를 보내드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 초안도 같이 올려야 하는 거예요?",
          "공지에 있는 문장이 애매하더라고요.",
          "저는 일단 최종본만 올려놨어요."
        ],
        "B": [
          "초안은 선택 사항이라 제출하지 않으셔도 괜찮아요.",
          "최종본만 업로드하시면 요구 조건은 충족돼요.",
          "그래도 확실히 하시려면 교수님께 간단히 메일로 문의해보셔도 좋아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "과제 다시 제출해도 되는지 알아요?",
          "저는 제출하고 나서 오타를 발견했어요.",
          "삭제하고 새로 올리면 되려나요?"
        ],
        "B": [
          "네, 다시 제출 가능해요.",
          "시스템이 최신 제출본만 반영하기 때문에 큰 문제는 없어요.",
          "오타가 있다면 수정해서 다시 업로드하는 게 더 좋을 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 발표 자료도 같이 올려야 해요?",
          "과제 설명은 텍스트만 제출하라고 되어 있었는데요.",
          "그래도 발표용 슬라이드는 필요하겠죠?"
        ],
        "B": [
          "슬라이드는 제출 대상은 아니었던 걸로 기억해요.",
          "발표 시간에만 준비해서 보여드리면 된다고 하셨어요.",
          "그래도 미리 제작해두면 나중에 훨씬 수월하긴 해요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "혹시 교수님이 채점 기준 올리신 거 봤어요?",
          "항목이 예전보다 조금 더 세분화된 것 같아요.",
          "저 부분이 점수에 많이 영향을 줄까요?"
        ],
        "B": [
          "네, 저도 조금 전 확인했어요.",
          "항목이 세분화되긴 했지만 점수 비중 자체는 크게 달라지지 않았어요.",
          "교수님 말씀으로는 내용의 명확성이 가장 중요하다고 하셨어요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "팀 과제 제출은 누가 맡기로 했죠?",
          "우리 팀 파일 합치는 작업이 아직 안 끝났거든요.",
          "오늘 안에 맡은 분이 제출해주실까요?"
        ],
        "B": [
          "제출은 민지 씨가 맡기로 했어요.",
          "지금 최종 파일을 정리 중이라고 들었어요.",
          "오늘 밤 안에는 제출하겠다고 했으니 걱정하지 않으셔도 될 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "휴… 과제 드디어 끝냈어요!",
          "제출 버튼 누르고 나니까 긴장이 확 풀리네요.",
          "이제 오늘은 좀 쉬어도 되겠죠?"
        ],
        "B": [
          "정말 고생 많으셨어요!",
          "제출하고 나면 힘이 빠지는 느낌 이해해요.",
          "오늘은 충분히 쉬시고 내일부터 다시 시작해도 괜찮을 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

