{
  "chapter_id": "001",
  "cefr": "B1",
  "title_kr": "기숙사 생활",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "기숙사 적응하고 있어요,",
    "룸메이트는 어떤 사람이에요?,",
    "생활 규칙은 괜찮아요?,",
    "불편한 점 있어요?,",
    "방 분위기는 어때요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "요즘 기숙사 생활은 좀 익숙해진 것 같아요.",
          "룸메이트랑도 생각보다 잘 맞는 편이에요.",
          "아직은 규칙이 많아서 조금 신경 쓰이긴 해요."
        ],
        "B": [
          "오, 벌써 적응했다니 다행이네요!",
          "룸메이트랑 잘 맞는다니 진짜 큰 복이에요.",
          "규칙은 익숙해지면 괜찮아질 거예요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "기숙사 방이 생각보다 조용해서 좋아요.",
          "덕분에 공부가 훨씬 잘돼요.",
          "밤에는 통금만 잘 지키면 문제 없더라고요."
        ],
        "B": [
          "와, 조용한 방이면 공부하기 정말 좋죠!",
          "집중 잘된다고 하니 저도 기분이 좋네요.",
          "통금은 익숙해지면 크게 신경 안 쓰일 거예요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "어제 기숙사 휴게실 가봤는데 분위기가 괜찮더라고요.",
          "사람들도 편하게 이야기하고 있어서 좋았어요.",
          "저도 나중에 종종 가보려고요."
        ],
        "B": [
          "맞아요, 그 휴게실 은근 분위기 좋아요!",
          "사람들이랑 자연스럽게 친해지기에도 좋아요.",
          "시간 나면 같이 가도 좋겠네요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "기숙사 첫 주에는 잠이 잘 안 왔는데 이제는 괜찮아졌어요.",
          "아무래도 새로운 환경이라 그런 것 같아요.",
          "지금은 오히려 편안해서 금방 잠들어요."
        ],
        "B": [
          "처음엔 다 그래요, 낯설어서요.",
          "하지만 빨리 적응했네요! 대단해요.",
          "편하게 느껴지면 생활하기 훨씬 좋죠."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "기숙사 식당 음식이 생각보다 맛있더라고요.",
          "종류도 다양해서 질리지 않아요.",
          "요즘은 아침도 챙겨 먹게 됐어요."
        ],
        "B": [
          "헉, 맛있다고요? 요즘 메뉴가 좋아졌나 보네요!",
          "다양하면 매일 골라 먹는 재미도 있죠.",
          "아침 챙겨 먹는 건 정말 좋은 습관이에요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "세탁실 사용하는 게 아직 조금 헷갈려요.",
          "요금 결제 방식이 생각보다 복잡하더라고요.",
          "좀 더 써보면 익숙해질 것 같아요."
        ],
        "B": [
          "아, 저도 처음엔 엄청 헷갈렸어요!",
          "결제 시스템이 진짜 복잡하긴 해요.",
          "필요하면 제가 한 번 알려드릴까요?"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "기숙사 사람들이 다 조용해서 분위기가 좋아요.",
          "밤에도 시끄럽지 않아서 편해요.",
          "덕분에 스트레스를 덜 받는 것 같아요."
        ],
        "B": [
          "오, 그런 분위기면 진짜 살기 좋죠!",
          "시끄러운 곳이면 잠도 잘 못 자는데 다행이에요.",
          "스트레스 줄어드는 게 제일 큰 장점이죠."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "기숙사 공용 부엌은 아직 잘 안 써봤어요.",
          "사람들이 많을까 봐 조금 망설여지더라고요.",
          "그래도 언젠가는 한 번 도전해보려고요."
        ],
        "B": [
          "공용 부엌 생각보다 괜찮아요!",
          "사람 없을 때 가면 편하게 쓸 수 있어요.",
          "처음만 넘기면 금방 익숙해질 거예요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "기숙사 와이파이가 요즘 좀 느린 것 같아요.",
          "특히 저녁 시간대는 거의 안 터져요.",
          "과제할 때 살짝 불편하더라고요."
        ],
        "B": [
          "맞아요! 저도 저녁엔 엄청 답답했어요.",
          "그 시간대에 다들 접속해서 그런가 봐요.",
          "필요하면 모바일 핫스팟 잠깐 쓰는 것도 방법이에요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "기숙사 생활이 생각보다 재미있다는 걸 느끼고 있어요.",
          "사람들과 자연스럽게 친해지는 것도 좋고요.",
          "올해는 꽤 즐겁게 지낼 수 있을 것 같아요."
        ],
        "B": [
          "오, 그렇게 느낀다니 너무 좋네요!",
          "기숙사에서 친구 생기면 진짜 추억 많이 생겨요.",
          "앞으로도 재밌는 일 많을 거예요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

