{
  "chapter_id": "006",
  "cefr": "B1",
  "title_kr": "발표 준비",
  "speaker_label_removed": true,
  "voice_validation_required": true,

  "key_expressions": [
    "발표 준비는 잘 되고 있어요?,",
    "자료 정리는 끝났어요?,",
    "시간 배분을 다시 해볼까요?,",
    "예시를 하나 더 넣어볼까요?,",
    "발표 연습 같이 해요!,"
  ],

  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "발표 준비는 좀 괜찮으세요?",
          "오, 다행이네요! 그럼 자료 정리는 거의 끝났나요?",
          "좋아요, 필요하시면 저도 조금 도와드릴게요."
        ],
        "B": [
          "네, 생각보다 잘 되고 있어요!",
          "거의 다 했는데 예시를 좀 더 넣을까 고민 중이에요.",
          "와, 감사해요! 그러면 조금만 봐주실래요?"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 발표 시간은 몇 분으로 정하셨어요?",
          "오, 생각보다 길네요! 시간 배분이 조금 어려우시겠어요.",
          "맞아요, 중간 설명을 조금 줄이면 괜찮을 것 같아요."
        ],
        "B": [
          "10분 정도로 맞추려고 해요.",
          "그러게요, 말하다 보면 자꾸 길어져서요.",
          "좋은 생각이에요! 한번 줄여볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "슬라이드는 몇 장 정도 준비하셨어요?",
          "오, 깔끔하네요! 그러면 흐름은 자연스럽게 이어져요?",
          "좋아요! 그 흐름 그냥 유지해도 충분히 좋아요."
        ],
        "B": [
          "한 12장 정도요.",
          "네, 도입부터 결론까지 자연스럽게 이어지긴 해요.",
          "그렇다면 더 다듬기만 하면 될 것 같아요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "발표 시작 멘트는 준비하셨어요?",
          "오, 부드럽고 좋아요! 듣기에도 편하겠네요.",
          "좋아요. 그 느낌 유지하면서 자연스럽게 이어가면 돼요."
        ],
        "B": [
          "네, '안녕하세요, 오늘 발표를 맡은…' 이렇게 시작하려고요.",
          "아, 그래요? 그 정도면 충분히 자연스러울 것 같아요!",
          "네, 조언 고마워요! 한번 연습해볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 발표할 때 제일 걱정되는 부분이 있어요?",
          "아 그 부분이군요! 예시를 하나 더 넣어보면 어때요?",
          "좋아요! 더 이해하기 쉬울 것 같아요."
        ],
        "B": [
          "중간에 개념 설명이 조금 어려워 보여서요.",
          "오, 그거 좋은 아이디어네요!",
          "바로 하나 추가해볼게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "발표 연습은 해보셨어요?",
          "오! 그러면 흐름은 어느 정도 익히셨겠네요.",
          "좋아요. 그럼 지금 한 번만 더 해보실래요?"
        ],
        "B": [
          "혼자 두 번 정도 해봤어요.",
          "네, 말할 때 크게 막히진 않았어요.",
          "좋아요! 지금 한번 해볼게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 발표 마무리 멘트도 만들어두셨어요?",
          "오, 간결하고 좋네요! 깔끔하게 끝날 것 같아요.",
          "좋아요. 전체 톤이랑도 잘 맞아요."
        ],
        "B": [
          "네, '이상으로 발표를 마치겠습니다'라고 하려고요.",
          "감사합니다 멘트도 넣으면 괜찮겠죠?",
          "오, 그렇네요! 추가해볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "혹시 답변 준비도 조금 해두셨어요?",
          "오, 질문 예측 잘하셨네요!",
          "좋아요! 그 정도면 충분히 대비된 것 같아요."
        ],
        "B": [
          "네, 예상 질문 몇 개는 정리해놨어요.",
          "답변도 미리 짧게 정리해놨어요.",
          "덕분에 좀 마음이 놓여요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "오늘 안에 마무리할 수 있을까요?",
          "와, 그럼 거의 끝났네요!",
          "좋아요! 마지막 확인만 하면 되겠어요."
        ],
        "B": [
          "네, 지금 속도면 충분히 가능해요!",
          "슬라이드도 거의 다 정리됐어요.",
          "마지막 체크 리스트만 보면 끝이에요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "그럼 마지막으로 리허설 한번 해볼까요?",
          "오, 자신감 있어 보이네요!",
          "좋아요. 그 에너지 그대로 가면 완벽할 거예요!"
        ],
        "B": [
          "좋아요! 지금 바로 해볼게요!",
          "오늘은 왠지 잘할 수 있을 것 같아요.",
          "응원 고마워요! 큰 힘 돼요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }

  ]
}

