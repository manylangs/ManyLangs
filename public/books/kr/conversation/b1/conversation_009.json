{
  "chapter_id": "009",
  "cefr": "B1",
  "title_kr": "동아리 활동",
  "speaker_label_removed": true,
  "voice_validation_required": true,

  "key_expressions": [
    "동아리 들어갔어요?,",
    "분위기는 어때요?,",
    "사람들이 친절해요?,",
    "활동이 잘 맞아요?,",
    "다음에 같이 가봐요!,"
  ],

  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "요즘 동아리 활동은 잘 하고 있어요?",
          "오, 첫인상이 좋았나 보네요! 어떤 분위기였어요?",
          "좋아요. 다음 모임 있을 때 저도 구경 가보고 싶어요."
        ],
        "B": [
          "네, 생각보다 재미있어서 계속 나가고 있어요!",
          "편하고 밝은 분위기라서 금방 적응됐어요.",
          "좋아요! 다음에 일정 나오면 알려드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "사람들이랑은 좀 친해졌어요?",
          "오, 그 친구랑 금방 친해졌군요!",
          "좋네요. 같이 활동하면 더 친해질 거예요."
        ],
        "B": [
          "네, 특히 한 친구랑 금방 친해졌어요.",
          "활동하면서 계속 얘기하다 보니 가까워졌어요.",
          "맞아요! 같이 하니까 더 재밌더라고요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "동아리 활동은 어떤 걸 주로 해요?",
          "와, 생각보다 다양하네요! 재미도 있겠어요.",
          "좋아요. 그런 활동이면 오래할 수 있을 것 같아요."
        ],
        "B": [
          "보통 같이 연습하거나 소규모 프로젝트를 해요.",
          "네, 매주 조금씩 다른 활동을 해서 지루하지 않아요.",
          "맞아요, 계속 배울 게 있어서 좋아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "처음 참여했을 때 어렵지는 않았어요?",
          "오, 그래도 다들 잘 챙겨줘서 괜찮았나 봐요!",
          "그럼 지금은 완전히 익숙해졌겠네요."
        ],
        "B": [
          "조금 긴장됐는데 금세 편해졌어요.",
          "네, 선배들이 먼저 말 걸어줘서 도움이 많이 됐어요.",
          "맞아요, 이제는 편하게 참여하고 있어요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "동아리 활동이랑 학교 공부랑 잘 병행되고 있어요?",
          "오, 그래도 균형을 잡으려고 노력 중이군요!",
          "맞아요, 너무 무리하지 말고 천천히 조절해요."
        ],
        "B": [
          "조금 바쁘긴 한데 최대한 균형 맞추려고 해요.",
          "맞아요, 시간 관리가 제일 어렵더라고요.",
          "네, 필요하면 활동도 조금 줄일 생각이에요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "혹시 동아리에서 맡은 역할도 있어요?",
          "오, 처음인데도 잘하고 있네요!",
          "좋아요, 그 역할이면 경험도 많이 쌓일 거예요."
        ],
        "B": [
          "네, 이번 달엔 진행 보조를 맡았어요.",
          "처음이라 조심스러웠는데 다들 도와줘서 괜찮았어요.",
          "응, 점점 익숙해지고 있어요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "다음 활동 일정은 정해졌어요?",
          "오, 이번에는 새로운 걸 하는군요!",
          "좋아요. 경험 쌓기에도 좋겠어요."
        ],
        "B": [
          "네, 이번 주말에 작은 공연 준비해요.",
          "맞아요, 이번엔 색다른 활동이라 기대돼요.",
          "응, 잘 준비해서 멋지게 해보고 싶어요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "활동하다 보면 힘든 점도 있어요?",
          "아, 체력이나 일정 부분이 어렵군요.",
          "그래도 잘하고 있어요! 필요하면 쉬어가도 돼요."
        ],
        "B": [
          "네, 일정이 겹칠 때가 제일 힘들어요.",
          "체력도 좀 필요해서 더 신경 써야겠더라고요.",
          "응, 필요할 때 잠깐 쉬면 괜찮아져요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "동아리 친구들이랑 따로 만나는 약속도 있어요?",
          "오, 모임 분위기 좋겠어요!",
          "다녀오면 어땠는지 꼭 말해줘요."
        ],
        "B": [
          "네, 이번 주 금요일에 같이 밥 먹기로 했어요.",
          "다들 편해서 모이면 정말 재밌어요.",
          "응, 갔다 와서 바로 알려줄게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "그럼 다음에 시간 되면 저도 같이 가도 될까요?",
          "와, 너무 좋네요! 분위기 좋으면 금방 친해지죠.",
          "좋아요! 일정 생기면 꼭 알려주세요."
        ],
        "B": [
          "그럼요! 동아리 친구들도 다들 친절해요.",
          "응, 다들 편해서 금방 친해질 거예요.",
          "좋아요! 일정 나오면 바로 말씀드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }

  ]
}

