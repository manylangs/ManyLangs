{
  "chapter_id": "007",
  "cefr": "A1",
  "title_kr": "길 묻기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "여기에서 가까워요?,",
    "어떻게 가요?,",
    "이 길이 맞나요?,",
    "걸어서 얼마나 걸려요?,",
    "저쪽 방향인가요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "저기요, 지하철역까지 어떻게 가요?",
          "아, 그렇게 멀지 않네요! 그쪽으로 쭉 가면 돼요?",
          "네, 감사합니다! 바로 가볼게요."
        ],
        "B": [
          "아, 지하철역이요? 이 길로 직진하면 바로 나와요.",
          "맞아요, 쭉 가다가 큰 건물 보이면 왼쪽으로 가면 돼요.",
          "네, 조심히 가세요!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 이 버스가 시청 가는 버스 맞나요?",
          "오! 다행이네요. 어디서 내려야 해요?",
          "좋아요, 감사합니다!"
        ],
        "B": [
          "네, 맞아요! 이 버스 타면 시청 가요.",
          "시청 앞 정거장에서 내리면 돼요. 안내도 떠요.",
          "천만에요!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "여기 근처에 은행 있어요?",
          "아, 저쪽 길이에요? 바로 보여요?",
          "좋아요! 금방 다녀올게요."
        ],
        "B": [
          "네, 이 골목 끝나면 바로 오른쪽에 있어요.",
          "네, 파란 간판 크게 보일 거예요.",
          "다녀오세요!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 여기서 박물관까지 멀어요?",
          "오, 생각보다 가까워서 다행이네요!",
          "네, 알려주셔서 감사합니다!"
        ],
        "B": [
          "아뇨, 걸어서 십 분 정도면 가요.",
          "저기 횡단보도 건너서 왼쪽으로 가면 바로예요.",
          "좋은 시간 보내세요!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "이 길로 계속 가면 맞나요?",
          "오! 거의 다 왔군요?",
          "좋아요, 조금만 더 가볼게요."
        ],
        "B": [
          "네, 맞아요! 이 길이 정문으로 가는 길이에요.",
          "네, 삼 분만 더 걸으면 보여요.",
          "파이팅입니다!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "여기 근처에 약국 있어요?",
          "오른쪽 골목이요? 금방 찾겠네요!",
          "감사합니다, 바로 가볼게요."
        ],
        "B": [
          "네, 저 골목으로 들어가면 바로 있어요.",
          "네, 파란 십자가 간판 보이면 그곳이에요.",
          "천천히 다녀오세요!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "저… 여기서 공원까지 어떻게 가요?",
          "아! 버스 타도 되겠네요?",
          "좋아요, 알려주셔서 감사합니다!"
        ],
        "B": [
          "공원은 좀 멀어서요. 버스 타면 편해요.",
          "네, 두 정거장만 가면 바로 앞이에요.",
          "별말씀을요!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "혹시 이 근처에 화장실 있어요?",
          "아! 안쪽에 있군요. 금방 찾을 수 있겠어요!",
          "고맙습니다!"
        ],
        "B": [
          "네, 저기 카페 안쪽으로 들어가면 있어요.",
          "계단 옆에 있어서 찾기 쉬워요.",
          "편하게 다녀오세요!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "혹시 지도 좀 봐주시겠어요? 길을 잘 모르겠어요.",
          "오! 제가 반대로 가고 있었네요?",
          "감사해요, 이제 제대로 갈 수 있겠어요."
        ],
        "B": [
          "네, 어디로 가실 건가요?",
          "네, 목적지는 반대 방향이에요.",
          "잘 찾아가세요!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "여기서 택시 잡기 쉬운가요?",
          "아! 저쪽 큰길에 나가면 되겠네요?",
          "좋아요, 바로 가볼게요!"
        ],
        "B": [
          "지금은 조금 어려워요. 큰길로 나가면 금방 잡혀요.",
          "네, 횡단보도 건너면 택시 많이 다녀요.",
          "좋은 하루 되세요!"
        ]
      }
    }
  ]
}
