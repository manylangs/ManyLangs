  "title_en": "Nationality_and_Languages",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "Where are you from?",
    "What language do you speak?",
    "Your Korean is good!",
    "Please speak slowly.",
    "Can you say that again?"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "Where are you from?",
          "Oh, that’s pretty far!",
          "Let’s talk more from now on!"
        ],
        "B": [
          "I’m from Spain.",
          "But I really like Korea!",
          "Yeah, sounds good!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "What language do you usually speak?",
          "Wow, so you can speak several languages!",
          "Let me know if you ever need help."
        ],
        "B": [
          "I speak Spanish, and a bit of English.",
          "That’s why Korean feels harder.",
          "Thanks! That really helps."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "How long have you been studying Korean?",
          "Oh! Longer than I expected.",
          "You’ll get even better soon!"
        ],
        "B": [
          "About six months now.",
          "But speaking is still hard for me.",
          "Thanks for the encouragement!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "Your Korean is really good!",
          "Your pronunciation sounds natural too.",
          "Keep it up!"
        ],
        "B": [
          "Really? I still feel lacking.",
          "Pronunciation worries me the most.",
          "I’ll keep practicing!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "Can you speak a bit more slowly?",
          "Ah, now I understand better.",
          "Thank you so much!"
        ],
        "B": [
          "Oh! I was too fast, sorry.",
          "Okay, I’ll slow down.",
          "Just tell me anytime."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "Could you say that again?",
          "Oh! So that’s what you meant.",
          "Now I get it perfectly!"
        ],
        "B": [
          "Sure! I said ‘Please come this way.’",
          "I didn’t explain enough earlier.",
          "Feel free to ask again!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "How is speaking Korean for you?",
          "Yeah, listening feels harder for me too.",
          "But you’re doing great!"
        ],
        "B": [
          "Speaking is okay, but listening is tough.",
          "Especially when people talk fast.",
          "Thanks for the compliment!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "Are you learning any other languages?",
          "Wow, you’re good with languages!",
          "You’re inspiring me too!"
        ],
        "B": [
          "Yeah, I’m learning a bit of French too.",
          "But the pronunciation is so different.",
          "Studying together would be nice!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "Do you have many Korean friends?",
          "Oh, that explains your pronunciation!",
          "Let’s keep practicing together."
        ],
        "B": [
          "Yeah, I met a few at school.",
          "They helped me a lot.",
          "Sure! Let’s practice."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "What’s the hardest part of learning Korean?",
          "Yeah, Korean grammar can be tricky.",
          "Take your time — you’ll get it!"
        ],
        "B": [
          "I think particles are the hardest.",
          "There are so many similar ones.",
          "True! But I’ll keep trying!"
        ]
      }
    }
  ]
}
