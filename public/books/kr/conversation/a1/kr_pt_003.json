  "title_pt": "Nacionalidade_e_Idiomas",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "De onde és?",
    "Que língua falas?",
    "O teu coreano é ótimo!",
    "Fala mais devagar, por favor.",
    "Podes repetir isso?"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "De onde és?",
          "Oh, isso é bem longe!",
          "Vamos conversar mais a partir de agora!"
        ],
        "B": [
          "Sou de Espanha.",
          "Mas gosto muito da Coreia!",
          "Sim, parece-me bem!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "Que língua falas normalmente?",
          "Uau, falas várias línguas!",
          "Se precisares de ajuda, diz-me."
        ],
        "B": [
          "Falo espanhol e um pouco de inglês.",
          "Por isso o coreano parece mais difícil.",
          "Obrigado! Isso vai ajudar."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "Há quanto tempo estudas coreano?",
          "Oh, mais tempo do que pensei!",
          "Vais melhorar ainda mais!"
        ],
        "B": [
          "Há cerca de seis meses.",
          "Mas falar ainda é difícil.",
          "Obrigado pelo incentivo!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "O teu coreano é mesmo bom!",
          "Até a tua pronúncia soa natural.",
          "Continua assim!"
        ],
        "B": [
          "A sério? Ainda não me sinto muito bom.",
          "A pronúncia é o que mais me preocupa.",
          "Vou praticar mais!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "Podes falar um pouco mais devagar?",
          "Ah, agora entendo melhor.",
          "Muito obrigado!"
        ],
        "B": [
          "Ah, falei muito depressa. Desculpa.",
          "Está bem, vou falar mais devagar.",
          "Diz-me sempre que precisares."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "Podes repetir o que disseste?",
          "Ah, então era isso!",
          "Agora percebo totalmente."
        ],
        "B": [
          "Claro! Disse: “Vem por aqui”.",
          "Acho que não expliquei bem antes.",
          "Pergunta outra vez quando quiseres."
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "Como é falar coreano para ti?",
          "Sim, ouvir também é difícil para mim.",
          "Mas estás a ir muito bem!"
        ],
        "B": [
          "Falar é ok, mas ouvir é duro.",
          "Principalmente quando as pessoas falam rápido.",
          "Obrigado pelo elogio!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "Estás a aprender outra língua também?",
          "Uau, és bom com línguas!",
          "Isso também me inspira."
        ],
        "B": [
          "Sim, estou a aprender um pouco de francês.",
          "Mas a pronúncia é muito diferente.",
          "Podíamos estudar juntos!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "Tens muitos amigos coreanos?",
          "Ah, por isso a tua pronúncia é boa!",
          "Vamos praticar juntos a partir de agora."
        ],
        "B": [
          "Sim, conheci alguns na escola.",
          "Eles ajudaram-me muito.",
          "Sim! Vamos praticar."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "O que é mais difícil no coreano?",
          "Sim, a gramática pode ser complicada.",
          "Vai com calma — vais conseguir!"
        ],
        "B": [
          "Acho que as partículas são o mais difícil.",
          "Há muitas e parecem-se.",
          "É verdade, mas vou continuar a tentar!"
        ]
      }
    }
  ]
}
