{
  "chapter_id": "009",
  "cefr": "A1",
  "title_kr": "음식 주문하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "추천 메뉴 있어요?,",
    "이거 맛있어요?,",
    "덜 매운 거 있어요?,",
    "포장도 돼요?,",
    "곧 나오나요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "안녕하세요, 추천 메뉴 뭐가 있어요?",
          "오, 맛있겠다! 많이 매워요?",
          "좋아요, 그걸로 주세요."
        ],
        "B": [
          "오늘은 이 파스타가 가장 인기 있어요!",
          "아니요, 생각보다 안 매워요.",
          "네, 하나 바로 준비할게요!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "이 수프는 어떤 맛이에요?",
          "오, 깔끔한 맛 좋네요! 양은 많아요?",
          "그럼 수프 하나 주세요."
        ],
        "B": [
          "담백하고 따뜻한 맛이에요.",
          "네, 한 그릇이면 충분히 배불러요.",
          "네, 바로 준비할게요!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "혹시 덜 매운 메뉴도 있어요?",
          "아, 그건 매운맛이 거의 없어요?",
          "좋네요, 하나 부탁드릴게요."
        ],
        "B": [
          "네, 이 요리는 거의 안 매워요.",
          "네, 어린아이도 잘 먹어요.",
          "네, 바로 해드릴게요!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "이거 포장도 되나요?",
          "오 좋네요! 포장하면 시간 오래 걸려요?",
          "네, 그럼 포장해 주세요."
        ],
        "B": [
          "네, 포장 가능합니다.",
          "아니요, 금방 돼요.",
          "금방 준비해드릴게요!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "음료는 뭐가 인기예요?",
          "오, 상큼한 맛 좋아해요! 얼음은 적게 넣어주세요.",
          "좋아요, 그걸로 부탁드릴게요."
        ],
        "B": [
          "요즘은 레몬티가 많이 나가요.",
          "네, 얼음 적게 해서 드릴게요.",
          "네, 하나 준비할게요!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "혹시 바로 먹을 수 있어요?",
          "아, 곧 나온다니 다행이네요!",
          "좋아요, 조금만 기다릴게요."
        ],
        "B": [
          "네, 지금 거의 다 됐어요.",
          "오 분 정도면 나올 거예요.",
          "금방 드릴게요!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "사이드 메뉴는 뭐가 있어요?",
          "오, 가볍게 먹기 좋겠네요! 양은 어떤가요?",
          "그럼 감자튀김 주세요."
        ],
        "B": [
          "샐러드랑 감자튀김이 있어요.",
          "적당해서 혼자 먹기 좋아요.",
          "네, 바로 준비할게요!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "이거 양이 많은 편인가요?",
          "오, 두 명도 먹을 수 있어요?",
          "좋아요! 친구랑 나눠 먹어야겠어요."
        ],
        "B": [
          "네, 꽤 푸짐한 편이에요.",
          "네, 둘이서도 충분해요.",
          "맛있게 드세요!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "여기 결제는 어떻게 해요?",
          "오, 여러 가지 선택 가능하네요!",
          "그럼 카드로 결제할게요."
        ],
        "B": [
          "카드, 현금 모두 가능해요.",
          "네, 요즘은 간편결제도 돼요.",
          "네, 카드 주세요!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "혹시 리필도 돼요?",
          "오, 무료 리필이군요? 좋네요!",
          "그럼 따뜻한 물로 리필 부탁드릴게요."
        ],
        "B": [
          "네, 일부 음료는 무료로 리필돼요.",
          "네, 부담 없이 말씀하세요.",
          "따뜻한 물로 바로 가져다드릴게요!"
        ]
      }
    }
  ]
}
