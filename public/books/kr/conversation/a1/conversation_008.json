{
  "chapter_id": "008",
  "cefr": "A1",
  "title_kr": "장소 묘사하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "어떤 곳이에요?,",
    "가까워요?,",
    "조용한가요?,",
    "사람이 많아요?,",
    "분위기가 어때요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "여기 카페 분위기 어때요?",
          "오, 좋아 보이네요! 음악도 조용해요?",
          "좋아요, 그럼 여기 앉을게요."
        ],
        "B": [
          "여기 꽤 아늑해요. 사람도 적고요.",
          "네, 잔잔한 음악만 나와요.",
          "편하게 앉으세요!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "이 근처 공원은 어떤 곳이에요?",
          "오, 산책하기 좋겠네요! 벤치도 많아요?",
          "좋아요, 한번 가볼게요."
        ],
        "B": [
          "조용하고 넓어요. 꽃도 많아요.",
          "네, 그늘 있는 자리도 많아요.",
          "즐거운 시간 보내세요!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "도서관 분위기 어때요?",
          "오, 집중 잘 되겠네요. 자리도 넉넉해요?",
          "좋네요, 저도 가볼게요."
        ],
        "B": [
          "정말 조용해요. 학생들도 예의 있어요.",
          "네, 창가 자리가 특히 많아요.",
          "금방 찾을 수 있을 거예요!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "여기 동네는 어떤 분위기예요?",
          "오, 안전한 동네라니 좋네요!",
          "그럼 산책도 편하게 할 수 있겠어요."
        ],
        "B": [
          "조용하고 가족들이 많아서 편해요.",
          "네, 밤에도 밝고 안전한 편이에요.",
          "산책하기 딱 좋아요!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "여기 운동장은 어때요?",
          "오, 넓은 공간 좋네요! 사람도 많아요?",
          "좋아요, 한번 뛰어봐야겠어요."
        ],
        "B": [
          "엄청 넓어요. 바닥도 깔끔하고요.",
          "시간대마다 다른데, 지금은 적어요.",
          "운동하기 좋은 날이에요!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "이 건물은 어떤 느낌이에요?",
          "오, 현대적인 분위기 좋네요! 로비는 넓어요?",
          "오, 그렇군요. 구경해봐야겠어요."
        ],
        "B": [
          "요즘 스타일이에요. 깔끔하고 세련됐어요.",
          "네, 천장도 높고 넓어요.",
          "구경하기 좋을 거예요!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "근처 시장 분위기 어때요?",
          "오, 활기차겠네요! 가게도 많아요?",
          "좋네요! 한번 가볼게요."
        ],
        "B": [
          "사람도 많고 활기차요.",
          "네, 먹거리 가게도 정말 많아요.",
          "구경하면 재밌을 거예요!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "이 카페는 조용한 편인가요?",
          "오, 공부하기에도 괜찮겠네요!",
          "좋아요, 여기서 조금 있을게요."
        ],
        "B": [
          "네, 주말 빼고는 조용한 편이에요.",
          "네, 학생들이 자주 와서 분위기 좋아요.",
          "편하게 쉬다 가세요!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "저 건물은 무슨 건물이에요?",
          "아, 그래서 사람들이 많군요!",
          "저도 구경 한번 해봐야겠어요."
        ],
        "B": [
          "거긴 전시관이에요. 자주 행사해요.",
          "네, 오늘도 작은 행사하고 있어요.",
          "가보면 재미있을 거예요!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "이곳 주변은 밤에 어때요?",
          "오, 밝으면 걷기 편하겠네요!",
          "감사해요, 참고할게요."
        ],
        "B": [
          "밤에도 큰길은 꽤 밝아요.",
          "네, 사람도 제법 있어서 무섭지 않아요.",
          "필요한 거 있으면 또 물어보세요!"
        ]
      }
    }
  ]
}
