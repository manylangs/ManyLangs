{
  "chapter_id": "006",
  "cefr": "A1",
  "title_pt": "Números e preços",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "Quanto custa isto?,",
    "Pode ficar mais barato?,",
    "Qual é o preço?,",
    "Há algum desconto?,",
    "Tem outras cores?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "Desculpe, quanto custa isto?",
          "Ah, não é assim tão caro. Pode fazer algum desconto?",
          "Ótimo! Fico com isto a esse preço."
        ],
        "B": [
          "Este custa 15 000 wons.",
          "Posso baixar um pouco—cerca de 1 000 wons.",
          "Muito bem, passo à cobrança."
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "Este chapéu é giro. Quanto é?",
          "Hmm… é um bocadinho caro. Tem outras cores?",
          "Então fico com o azul."
        ],
        "B": [
          "Esse chapéu custa 20 000 wons.",
          "Sim! Temos em azul e preto.",
          "Perfeito, já trago o azul."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "Quanto custa esta bebida?",
          "Ah! Nada mau. Posso mudar o tamanho?",
          "Então quero o tamanho grande, por favor."
        ],
        "B": [
          "O tamanho normal é 4 000 wons.",
          "Sim, o grande custa mais 1 000 wons.",
          "Muito bem, preparo um grande."
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "Se levar dois, quanto fica?",
          "Oh, é mais barato do que pensei!",
          "Está bem, levo os dois."
        ],
        "B": [
          "Os dois ficam por 10 000 wons.",
          "Estão em promoção agora, por isso sai mais barato.",
          "Muito bem, vou embrulhar."
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "Tem um tamanho mais pequeno?",
          "Ótimo! O preço muda?",
          "Então quero o mais pequeno."
        ],
        "B": [
          "Sim, temos um tamanho mais pequeno.",
          "O preço é o mesmo.",
          "Muito bem, já trago o pequeno."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "Hum… qual é o artigo mais barato aqui?",
          "Ah, boa. Posso comprar já?",
          "Perfeito, fico com um."
        ],
        "B": [
          "O mais barato é este—custa 3 000 wons.",
          "Sim, pode comprar já.",
          "Muito bem, preparo um para si."
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "Aceitam pagamento com cartão?",
          "Ótimo. Não há taxas adicionais, pois não?",
          "Está bem, pago com cartão."
        ],
        "B": [
          "Sim, aceitamos cartão.",
          "Isso mesmo, sem taxas extra.",
          "Muito bem, vou processar o pagamento."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "Isto é novo?",
          "Ótimo! É o último?",
          "Então compro já."
        ],
        "B": [
          "Sim, é completamente novo.",
          "Sim, é o último que temos.",
          "Perfeito, já preparo tudo."
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "O preço indicado está correto?",
          "Ah, está em promoção?",
          "Então é melhor comprar agora!"
        ],
        "B": [
          "Sim, antes custava 18 000 wons.",
          "Agora está em promoção por 15 000 wons.",
          "Exato—só até hoje."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "Com embrulho de oferta, quanto fica?",
          "Ah, a taxa de embrulho é mais barata do que pensei.",
          "Está bem, embrulhe por favor."
        ],
        "B": [
          "Com o embrulho, fica por 12 000 wons.",
          "Sim, o embrulho custa apenas 1 000 wons.",
          "Muito bem, faço um embrulho bonito."
        ]
      }
    }
  ]
}
