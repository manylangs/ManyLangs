    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 여기 시그니처 메뉴 있어요?",
          "오, 고소한 맛 좋아요! 많이 진해요?",
          "네, 하나 주문할게요."
        ],
        "B": [
          "네! 시그니처로는 연유라떼가 있어요.",
          "진하지만 부드러워요.",
          "네, 연유라떼 하나 준비해드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
