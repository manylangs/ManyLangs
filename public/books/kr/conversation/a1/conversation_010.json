      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "이거 포장도 되나요?",
          "아, 포장 시간은 길지 않아요?",
          "좋아요, 그럼 포장해주세요."
        ],
        "B": [
          "네, 포장 가능합니다.",
          "아니요, 1~2분이면 돼요.",
          "네, 바로 포장해드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "샌드위치도 주문할 수 있어요?",
          "오, 따뜻하게 데워주실 수 있어요?",
          "좋아요, 따뜻하게 해서 주세요."
        ],
        "B": [
          "네, 샌드위치 종류도 있어요.",
          "네, 원하시면 따뜻하게 데워드려요.",
          "알겠습니다, 데워서 드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "결제는 어떻게 해요?",
          "오, 간편결제도 되네요!",
          "좋아요, 그럼 카드로 결제할게요."
        ],
        "B": [
          "카드, 현금 다 돼요.",
          "네, 요즘은 간편결제도 가능해요.",
          "네, 카드 주세요!"
        ]
