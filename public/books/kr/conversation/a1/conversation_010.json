{
  "chapter_id": "010",
  "cefr": "A1",
  "title_kr": "카페에서 주문하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "어떤 메뉴가 인기예요?,",
    "덜 달게 가능해요?,",
    "얼음 적게 넣어주세요?,",
    "포장도 되나요?,",
    "기다리는 시간 얼마나 돼요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "안녕하세요, 여기 인기 메뉴 뭐예요?",
          "오, 달콤한 맛이구나! 많이 달아요?",
          "좋아요, 그 음료로 하나 주세요."
        ],
        "B": [
          "안녕하세요! 요즘은 바닐라라떼가 제일 인기예요.",
          "아니요, 은은하게 달아요.",
          "네, 바닐라라떼 하나 바로 준비할게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
