    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 덜 달게도 가능해요?",
          "아, 반만 넣을 수 있어요?",
          "그럼 시럽은 조금만 넣어주세요."
        ],
        "B": [
          "네, 단맛 조절 가능해요.",
          "네! 시럽 반만 넣어드릴게요.",
          "알겠습니다, 조금만 넣어드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "아이스 음료인데 얼음 적게 할 수 있나요?",
          "오, 너무 차지 않으면 좋겠다!",
          "좋아요, 얼음은 아주 조금만 넣어주세요."
        ],
        "B": [
          "네, 얼음 양 조절돼요.",
          "네, 얼음 적게 넣으면 더 부드러워요.",
          "네, 얼음 조금만 넣어드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "음료 나오기까지 얼마나 걸려요?",
          "오, 생각보다 금방이네요!",
          "좋아요, 잠깐 기다릴게요."
        ],
        "B": [
          "지금 주문 들어간 거라 3분 정도면 돼요.",
          "네, 금방 나올 거예요.",
          "네, 준비되면 바로 불러드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A"},
        "B": { "tts_voice": "ko-KR-Standard-B"}
