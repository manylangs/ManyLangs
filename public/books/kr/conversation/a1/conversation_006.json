{
  "chapter_id": "006",
  "cefr": "A1",
  "title_kr": "숫자와 가격",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "이거 얼마예요?,",
    "조금 더 싸요?,",
    "가격이 어떻게 돼요?,",
    "할인 있어요?,",
    "다른 색도 있어요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "저기요, 이거 얼마예요?",
          "생각보다 괜찮은데요. 혹시 할인도 되나요?",
          "좋아요! 그 가격이면 살게요."
        ],
        "B": [
          "아, 그건 15,000원이에요!",
          "지금은 천 원 정도만 깎아드릴 수 있어요.",
          "네, 계산 도와드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "이 모자 예쁘네요. 가격이 어떻게 돼요?",
          "음… 조금 비싸네요. 다른 색도 있어요?",
          "그럼 파란색으로 해볼게요!"
        ],
        "B": [
          "그 모자는 20,000원이에요.",
          "네! 파란색이랑 검정색 있어요.",
          "좋아요, 파란색 챙겨드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "여기 음료는 얼마예요?",
          "오! 괜찮네요. 사이즈 변경도 돼요?",
          "그럼 라지로 주세요!"
        ],
        "B": [
          "기본 사이즈는 4,000원이에요.",
          "네, 라지는 1,000원 추가돼요.",
          "네, 라지로 준비할게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "이거 두 개 사면 얼마인가요?",
          "오, 생각보다 싸네요!",
          "좋아요. 두 개 다 주세요."
        ],
        "B": [
          "두 개면 10,000원이에요.",
          "지금 행사 중이라 좀 저렴해요.",
          "네, 바로 포장해드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 이거 더 작은 사이즈도 있나요?",
          "좋네요! 가격 차이는 없어요?",
          "그럼 작은 걸로 할게요."
        ],
        "B": [
          "네, 작은 사이즈도 있어요.",
          "가격은 똑같아요!",
          "네, 작은 사이즈로 드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "저… 여기서 제일 싼 물건이 뭐예요?",
          "오, 괜찮네요. 지금 바로 살 수 있어요?",
          "좋아요! 하나 주세요."
        ],
        "B": [
          "가장 싼 건 이 제품인데 3,000원이에요.",
          "네, 바로 구매 가능해요!",
          "네, 하나 챙겨드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 카드 결제도 되나요?",
          "아, 좋아요. 수수료는 따로 없죠?",
          "네, 그럼 카드로 할게요."
        ],
        "B": [
          "네, 카드도 됩니다!",
          "네, 수수료 없이 그대로예요.",
          "결제 진행할게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "이거 새 제품 맞나요?",
          "좋아요! 혹시 마지막 재고인가요?",
          "그럼 바로 살게요."
        ],
        "B": [
          "네, 완전 새 제품이에요!",
          "네, 지금 이게 마지막이에요.",
          "네! 바로 준비하겠습니다."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "여기 적힌 가격이 맞나요?",
          "오, 할인 중이네요?",
          "그럼 지금 사는 게 좋겠네요!"
        ],
        "B": [
          "네, 원래 18,000원인데요.",
          "지금 15,000원으로 할인 중이에요!",
          "맞아요, 오늘까지예요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "포장까지 하면 총 얼마예요?",
          "오, 포장비가 생각보다 싸네요!",
          "좋아요, 포장해 주세요."
        ],
        "B": [
          "포장비 포함해서 12,000원이에요.",
          "네, 천 원밖에 안 해요.",
          "네, 예쁘게 포장해드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
