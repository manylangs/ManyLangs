{
  "chapter_id": "003",
  "cefr": "A1",
  "title_es": "Nacionalidad_y_Idiomas",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "¿De dónde eres?",
    "¿Qué idioma hablas?",
    "¡Hablas bien coreano!",
    "Habla un poco más despacio, por favor.",
    "¿Puedes repetir eso?"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "¿De dónde eres?",
          "Oh, ¡eso está bastante lejos!",
          "Hablemos más a partir de ahora."
        ],
        "B": [
          "Soy de España.",
          "Pero me encanta Corea.",
          "¡Sí, claro!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "¿Qué idioma hablas normalmente?",
          "¡Wow, hablas varios idiomas!",
          "Si necesitas ayuda, dímelo."
        ],
        "B": [
          "Hablo español y un poco de inglés.",
          "Por eso el coreano me parece más difícil.",
          "¡Gracias! Eso me ayudará."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "¿Cuánto tiempo llevas estudiando coreano?",
          "Oh, ¡más tiempo del que pensé!",
          "Seguro mejorarás aún más."
        ],
        "B": [
          "Unos seis meses.",
          "Pero todavía me cuesta hablar.",
          "¡Gracias por el ánimo!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "¡Hablas coreano muy bien!",
          "Hasta tu pronunciación suena natural.",
          "¡Sigue así!"
        ],
        "B": [
          "¿De verdad? Aún no me siento muy bueno.",
          "La pronunciación es lo que más me preocupa.",
          "Seguiré practicando."
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "¿Puedes hablar un poco más despacio?",
          "Ah, ahora lo entiendo mejor.",
          "¡Muchas gracias!"
        ],
        "B": [
          "Oh, hablé demasiado rápido. Perdón.",
          "Vale, hablaré más despacio.",
          "Dímelo siempre que lo necesites."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "¿Puedes repetir lo que dijiste?",
          "Ah, así que eso querías decir.",
          "Ahora lo entiendo muy bien."
        ],
        "B": [
          "Claro. Dije: “Ven por aquí”.",
          "Creo que no expliqué bien antes.",
          "Pregúntame de nuevo cuando quieras."
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "¿Cómo te va hablando coreano?",
          "Sí, escuchar también es difícil para mí.",
          "Pero lo estás haciendo muy bien."
        ],
        "B": [
          "Hablar está bien, pero escuchar es duro.",
          "Sobre todo cuando la gente habla rápido.",
          "¡Gracias por el cumplido!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "¿Estás aprendiendo otro idioma?",
          "¡Wow, eres bueno con los idiomas!",
          "Eso también me motiva."
        ],
        "B": [
          "Sí, estoy aprendiendo un poco de francés.",
          "Pero la pronunciación es muy diferente.",
          "Podríamos estudiar juntos."
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "¿Tienes muchos amigos coreanos?",
          "¡Ah, por eso tu pronunciación es buena!",
          "Practiquemos juntos de ahora en adelante."
        ],
        "B": [
          "Sí, conocí a algunos en la escuela.",
          "Ellos me ayudaron mucho.",
          "Sí, practiquemos juntos."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "¿Qué es lo más difícil del coreano?",
          "Sí, la gramática puede ser complicada.",
          "Tómate tu tiempo, lo lograrás."
        ],
        "B": [
          "Creo que las partículas son lo más difícil.",
          "Hay muchas y se parecen.",
          "Es verdad, pero seguiré intentándolo."
        ]
      }
    }
  ]
}
