{
  "chapter_id": "009",
  "cefr": "A1",
  "title_es": "Pedir comida",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "¿Alguna recomendación?,",
    "¿Está rico?,",
    "¿Tiene algo menos picante?,",
    "¿Puedo llevar esto para llevar?,",
    "¿Saldrá pronto?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "Hola, ¿me recomienda algún plato?",
          "Oh, ¡suena delicioso! ¿Es muy picante?",
          "Genial, voy a pedir ese."
        ],
        "B": [
          "Sí, esta pasta es la más popular hoy.",
          "No, no es muy picante.",
          "Perfecto, lo preparo ahora mismo."
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "¿A qué sabe esta sopa?",
          "Oh, un sabor suave suena bien. ¿La ración es grande?",
          "Entonces, quiero una sopa."
        ],
        "B": [
          "Es suave y calentita.",
          "Sí, un bol llena bastante.",
          "Muy bien, ya la preparo."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "¿Tiene algo menos picante?",
          "Ah, ¿ese plato casi no pica?",
          "Perfecto, quiero uno."
        ],
        "B": [
          "Sí, este casi no pica nada.",
          "Incluso los niños lo comen sin problema.",
          "Muy bien, lo preparo enseguida."
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "¿Puedo llevar esto para llevar?",
          "Ah, ¡qué bien! ¿Tarda mucho en prepararse?",
          "Vale, por favor póngalo para llevar."
        ],
        "B": [
          "Sí, se puede llevar.",
          "No, tardamos muy poco.",
          "Lo preparo ahora mismo."
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "¿Qué bebidas son populares aquí?",
          "Oh, me gusta lo refrescante. ¿Puede poner menos hielo?",
          "Genial, quiero esa."
        ],
        "B": [
          "El té de limón es muy popular estos días.",
          "Claro, pondré menos hielo.",
          "Perfecto, la preparo."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "¿La comida estará lista pronto?",
          "Oh, ¡qué bien! Me alegra que no tarde mucho.",
          "Vale, esperaré un momento."
        ],
        "B": [
          "Sí, ya casi está lista.",
          "Saldrá en unos cinco minutos.",
          "Se la llevo enseguida."
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "¿Qué acompañamientos tienen?",
          "Oh, suena ligero. ¿La ración es grande?",
          "Entonces quiero las patatas fritas."
        ],
        "B": [
          "Tenemos ensalada y patatas fritas.",
          "Es una ración adecuada para una persona.",
          "Muy bien, lo preparo."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "¿Esta ración es grande?",
          "Oh, ¿la pueden compartir dos personas?",
          "Perfecto, la compartiré con un amigo."
        ],
        "B": [
          "Sí, es bastante grande.",
          "Sí, es suficiente para dos.",
          "¡Buen provecho!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "¿Cómo se paga aquí?",
          "Oh, qué bien. Hay varias opciones.",
          "Vale, pagaré con tarjeta."
        ],
        "B": [
          "Aceptamos tarjeta y efectivo.",
          "Sí, también funciona el pago móvil.",
          "Perfecto, deme su tarjeta."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "¿Hacen recargas?",
          "¿Recarga gratis? ¡Qué bien!",
          "Entonces quiero una recarga con agua caliente."
        ],
        "B": [
          "Sí, algunas bebidas tienen recarga gratis.",
          "Sí, pida cuando quiera.",
          "Traigo el agua caliente enseguida."
        ]
      }
    }
  ]
}
