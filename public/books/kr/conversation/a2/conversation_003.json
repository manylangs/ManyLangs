{
  "chapter_id": "003",
  "cefr": "A2",
  "title_kr": "시간과 요일",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "몇 시에 만날까요?,",
    "오늘 일정 있어요?,",
    "주말에 시간 괜찮아요?,",
    "지금 바로 가능해요?,",
    "다음 주도 괜찮아요.,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "오늘 몇 시에 만날까요?",
          "그럼 세 시는 어때요?",
          "좋아요! 그때 봐요!"
        ],
        "B": [
          "음… 오후가 더 괜찮아요!",
          "오, 세 시 딱 좋아요!",
          "네, 약속해요!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "오늘 일정 있어요?",
          "오, 그렇군요! 그럼 점심은 가능해요?",
          "그럼 열두 시에 봬요!"
        ],
        "B": [
          "네, 오전에 조금 바빠요.",
          "점심은 괜찮아요!",
          "좋아요, 열두 시에 만나요!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "주말에 시간 괜찮아요?",
          "오! 토요일 오후 괜찮아요!",
          "그럼 토요일에 봐요!"
        ],
        "B": [
          "네, 주말은 좀 여유 있어요.",
          "그 시간 좋아요!",
          "좋아요, 기대할게요!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "지금 잠깐 이야기할 시간 있어요?",
          "오, 다행이에요! 몇 분 괜찮아요?",
          "그럼 바로 전화할게요!"
        ],
        "B": [
          "네, 지금은 조금 괜찮아요.",
          "한 십 분 정도는 괜찮아요.",
          "네, 기다릴게요!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "다음 주에 언제 시간 되세요?",
          "오! 그날 오후 좋아요!",
          "그럼 일정 잡을게요!"
        ],
        "B": [
          "화요일은 괜찮을 것 같아요.",
          "좋아요, 오후 시간 비워둘게요!",
          "좋아요, 그때 봬요!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "오늘 저녁에 시간 되세요?",
          "오! 그래요? 그럼 내일은요?",
          "좋아요! 내일 저녁에 연락드릴게요!"
        ],
        "B": [
          "오늘은 좀 늦게 끝날 것 같아요.",
          "내일 저녁은 괜찮아요!",
          "네, 내일 봬요!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 오늘 아침도 가능하세요?",
          "아! 그렇군요! 오후엔 괜찮으세요?",
          "좋아요! 그럼 오후에 뵐게요!"
        ],
        "B": [
          "아침엔 약속이 있어요.",
          "오후는 비어 있어요!",
          "도움 돼요! 그때 봬요."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "오늘 회의 몇 시에 시작해요?",
          "오! 조금 늦을 수도 있어요.",
          "네! 최대한 빨리 갈게요!"
        ],
        "B": [
          "세시에 시작해요.",
          "그래도 오 분은 괜찮아요!",
          "알겠어요! 곧 봬요."
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "오늘 저녁에 뭐 하세요?",
          "오! 저도 그 시간에 괜찮아요!",
          "그럼 같이 산책해요!"
        ],
        "B": [
          "저녁엔 잠깐 산책하려고 해요.",
          "좋아요! 그때 봐요!",
          "네, 산책 좋아요!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "오늘 하루 어땠어요?",
          "오, 그래도 잘 버티셨네요!",
          "내일은 더 좋은 하루 되길 바랄게요!"
        ],
        "B": [
          "조금 피곤했어요.",
          "맞아요, 그래도 괜찮아요!",
          "고마워요! 내일 더 힘낼게요!"
        ]
      }
    }
  ]
}

