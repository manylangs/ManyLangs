  "title_kr": "날씨 이야기하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "오늘 날씨 어때요?",
    "생각보다 덥네요",
    "비 올 것 같아요",
    "우산 챙기세요",
    "날씨가 갑자기 변하네요"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": ["오늘 날씨 좀 이상하지 않아요?", "근데 갑자기 바람도 세진 것 같아요.", "집에 갈 때 비 오면 어쩌죠?"],
        "B": ["그러게요, 미세먼지도 좀 있는 것 같아요.", "맞아요, 체감 온도도 더 낮아졌어요.", "일단 우산 챙겨가세요. 소나기 올 수도 있어요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 2,
      "dialogue_layer": {
        "A": ["오늘 왜 이렇게 더운 거죠?", "에어컨 없으면 진짜 못 버티겠어요.", "혹시 오후에도 계속 더울까요?"],
        "B": ["진짜 덥죠? 거의 한여름 같아요.", "맞아요, 햇빛도 엄청 강해요.", "예보 보니까 저녁까지는 덥다던데요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 3,
      "dialogue_layer": {
        "A": ["혹시 오늘 비 온다고 들으셨어요?", "빗방울 떨어지는 소리도 나는 것 같아요.", "그럼 우산 꼭 챙겨야겠네요."],
        "B": ["네, 오후에 소나기 예보 있던데요.", "오 맞아요, 습도도 갑자기 높아졌어요.", "맞아요, 안 챙기면 후회할 수도 있어요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 4,
      "dialogue_layer": {
        "A": ["오늘 바람이 꽤 강하네요.", "머리카락이 계속 날려서 불편해요.", "이 정도면 우산도 뒤집힐 것 같아요."],
        "B": ["맞아요, 체감 온도도 더 춥게 느껴져요.", "저도 아까 모자 날아갈 뻔했어요.", "웬만하면 우산 말고 후드 쓰는 게 낫겠어요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 5,
      "dialogue_layer": {
        "A": ["요즘 아침·저녁 기온 차가 크네요.", "아침엔 춥다가 낮엔 또 너무 더워요.", "그래서 옷을 어떻게 입어야 할지 모르겠어요."],
        "B": ["맞아요, 진짜 애매한 날씨예요.", "저도 매일 얇은 거랑 두꺼운 거 같이 챙겨요.", "겹쳐 입는 게 가장 안전한 것 같아요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 6,
      "dialogue_layer": {
        "A": ["하늘이 갑자기 어두워졌어요.", "바람도 세지고 분위기가 딱 비 올 것 같아요.", "이러다 소나기 바로 내리겠어요."],
        "B": ["맞아요, 구름이 금방 몰려왔네요.", "습해진 거 보니까 거의 확정이죠.", "빨리 이동하는 게 좋겠어요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 7,
      "dialogue_layer": {
        "A": ["오늘은 공기가 너무 좋지 않아요.", "눈도 좀 따가운 느낌이에요.", "마스크 꼭 쓰고 다녀야겠어요."],
        "B": ["그러게요, 미세먼지가 꽤 심하대요.", "저도 목이 좀 칼칼하더라고요.", "맞아요, 마스크 쓰면 훨씬 나아요."]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 8,
      "dialogue_layer": {
        "A": ["햇살이 오늘은 유난히 좋네요.", "따뜻해서 기분이 좀 좋아지는 것 같아요.", "이럴 때 산책하면 딱 좋겠어요."],
        "B": ["맞아요, 봄 같은 느낌이에요.", "햇빛이 부드러워서 좋네요.", "그럼 점심시간에 잠깐 나가보죠!"]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 9,
      "dialogue_layer": {
        "A": ["오늘은 좀 흐리네요.", "이런 날은 집중도 잘 안 돼요.", "빨리 해가 다시 떴으면 좋겠어요."],
        "B": ["맞아요, 왠지 졸린 날씨예요.", "저도 일하기가 좀 힘들더라고요.", "곧 맑아진다니까 조금만 버텨봐요!"]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 10,
      "dialogue_layer": {
        "A": ["오늘 날씨가 왜 이렇게 변덕스러울까요?", "아까는 맑았다가 지금은 또 흐려졌어요.", "이러면 일정 잡기 진짜 어렵네요."],
        "B": ["요즘 날씨가 계속 이래요.", "저도 예보를 믿기가 힘들어요.", "일단 대비만 잘해두면 괜찮을 것 같아요!"]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
