  "title_kr": "교통수단 이용하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "어떻게 가는 게 빨라요?",
    "버스가 자주 와요?",
    "지하철이 더 편해요",
    "여기서 갈아타요",
    "길이 많이 막히네요"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": ["여기서 역까지 얼마나 걸려요?", "걸어가기엔 조금 멀 것 같아요.", "그럼 지하철이 제일 빠르겠죠?"],
        "B": ["걸어서 15분 정도요.", "맞아요, 버스도 있긴 해요.", "네, 지하철 타면 금방 도착해요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 2,
      "dialogue_layer": {
        "A": ["이 버스 시내 방향 맞나요?", "정류장이 바로 앞이라 편하네요.", "근데 버스 자주 오나요?"],
        "B": ["네, 시내 가는 방향 맞아요.", "맞아요, 여기서 타면 금방 와요.", "보통 7~8분 간격으로 와요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 3,
      "dialogue_layer": {
        "A": ["지하철 2호선 갈아타는 곳이 어디예요?", "생각보다 복잡하네요.", "그럼 에스컬레이터 타면 바로 나오겠어요."],
        "B": ["저쪽 표시 따라가면 돼요.", "처음 오면 조금 헷갈릴 수 있어요.", "네, 바로 앞에 있어요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 4,
      "dialogue_layer": {
        "A": ["택시 잡기 힘들죠, 요즘?", "승차 지점도 계속 바뀌는 것 같아요.", "그래도 금방 오면 좋겠네요."],
        "B": ["맞아요, 출퇴근 시간엔 더 어려워요.", "네, 주변 공사 때문에 그래요.", "조금만 기다리면 잡힐 거예요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 5,
      "dialogue_layer": {
        "A": ["오늘 길이 왜 이렇게 막혀요?", "버스가 거의 안 움직이네요.", "늦지 않았으면 좋겠어요."],
        "B": ["아침 사고 때문에 그런가 봐요.", "저도 일정이 있어서 걱정돼요.", "조금 후면 풀릴 거예요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 6,
      "dialogue_layer": {
        "A": ["공항 가려면 어떤 교통수단이 좋아요?", "짐이 좀 많아서 고민돼요.", "그럼 공항버스가 더 편하겠네요."],
        "B": ["시간 맞으면 공항철도도 괜찮아요.", "짐 많으면 택시는 좀 불편하죠.", "네, 좌석도 넓고 바로 가요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 7,
      "dialogue_layer": {
        "A": ["따릉이 대여소가 어디에 있어요?", "앱으로 보니까 근처에 있던데요.", "그럼 조금만 걸어가면 되겠네요."],
        "B": ["저쪽 횡단보도 건너면 바로 있어요.", "네, 여기서 2~3분 거리예요.", "맞아요, 자전거도 많이 남아있을 거예요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 8,
      "dialogue_layer": {
        "A": ["이 지하철 노선 맞게 타고 있는 거죠?", "역 이름이 비슷해서 헷갈렸어요.", "다행이다, 잘못 탈까 봐 걱정했어요."],
        "B": ["네, 맞는 방향이에요.", "처음 보면 헷갈릴 수 있어요.", "걱정 마세요, 곧 목적지 나와요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 9,
      "dialogue_layer": {
        "A": ["버스카드 충전 어디서 해요?", "편의점에서도 되죠?", "그럼 여기서 바로 충전해야겠어요."],
        "B": ["지하철역 기계에서도 돼요.", "네, 편의점에서도 충전 가능해요.", "금방 끝나요, 어렵지 않아요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    },
    {
      "set_id": 10,
      "dialogue_layer": {
        "A": ["막차 시간 지났을까요?", "아슬아슬하게 늦은 것 같아요.", "택시 말고 다른 방법이 있을까요?"],
        "B": ["아직 조금 남았을 수도 있어요.", "주말이라 배차가 더 느려요.", "심야버스가 있으니까 그거 타면 돼요."]
      },
      "tts_layer": { "A": { "tts_voice": "ko-KR-Standard-A"}, "B": { "tts_voice": "ko-KR-Standard-B"} }
    }
  ]
