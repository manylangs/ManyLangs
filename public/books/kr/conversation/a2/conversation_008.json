{
  "chapter_id": "008",
  "cefr": "A2",
  "title_kr": "취미 이야기하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "취미가 뭐예요?",
    "시간 날 때 뭐 해요?",
    "요즘 재미있어요",
    "같이 해볼래요?",
    "생각보다 어렵네요"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": ["혹시 취미 뭐 있어요?", "와, 생각보다 활동적인 취미네요.", "그럼 주말마다 나가서 하세요?"],
        "B": ["저는 등산 좋아해요!", "네, 가끔 힘들지만 재밌어요.", "주말에 시간 되면 꼭 가려고 해요."]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": ["요즘 새 취미 찾고 있어요.", "피아노는 손이 안 따라가서 어렵더라고요.", "그래도 배우면 재미있을 것 같아요."],
        "B": ["오, 음악 쪽 좋아하시는군요!", "처음엔 다 그래요, 손이 익으면 돼요.", "맞아요, 하나씩 치다 보면 금방 늘어요."]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": ["시간 날 때 뭐 하세요?", "오, 저도 가끔 영상 찍는 거 좋아해요.", "편집은 생각보다 어렵죠?"],
        "B": ["저는 요즘 브이로그 찍어요.", "우와, 같이 얘기할 거 많겠네요!", "맞아요, 시간도 오래 걸리고 집중도 필요해요."]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": ["독서 좋아하세요?", "저도 소설 읽는 거 진짜 좋아해요.", "추천할 만한 책 있어요?"],
        "B": ["네! 특히 미스터리 좋아해요.", "오, 저도 그런 분위기 좋아요!", "제가 최근에 읽은 책 하나 추천해드릴게요."]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": ["운동 즐겨 하세요?", "요즘 체력이 부족한 것 같아서요.", "그 운동은 어렵지 않아요?"],
        "B": ["네, 요가 자주 해요.", "맞아요, 꾸준히 해야 힘이 생겨요.", "초반엔 조금 힘든데, 익숙해지면 괜찮아요."]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": ["요즘 뭐에 빠져 있어요?", "사진 찍는 거 진짜 매력 있더라고요.", "근데 카메라 설정은 좀 어렵죠?"],
        "B": ["저는 사진 촬영에 빠졌어요.", "그쵸? 순간을 담는 게 재밌어요.", "맞아요, 처음엔 복잡하지만 금방 익숙해져요."]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": ["게임 좋아하세요?", "그 게임 친구들이 다 재밌다고 하더라고요.", "기회 되면 같이 해봐요!"],
        "B": ["네, 저는 게임 자주 해요.", "맞아요, 하다 보면 시간 금방 가요!", "좋아요, 같이 하면 더 재밌죠."]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": ["요리 취미로 하세요?", "와, 직접 만든 거 먹으면 더 맛있죠!", "혹시 쉬운 요리 하나 추천해 주세요."],
        "B": ["네, 요즘 집에서 요리 자주 해요.", "맞아요, 뿌듯하기도 하고요!", "파스타 같은 거 쉬워요. 금방 만들 수 있어요."]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": ["취미로 뭐 배우고 싶어요?", "오, 춤은 리듬감도 필요해서 어렵잖아요.", "그래도 배우면 진짜 재밌을 것 같아요!"],
        "B": ["저는 춤을 배우고 싶어요.", "그래서 연습하려고 음악도 찾아보고 있어요.", "맞아요, 몸이 풀리면 훨씬 재밌어요."]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": ["시간 생기면 뭐 하고 싶어요?", "아, 저도 여행 정말 좋아해요!", "그 여행지는 너무 매력적일 것 같아요."],
        "B": ["전 여행 다니고 싶어요.", "새로운 곳 가면 기분이 너무 좋아요!", "네, 풍경도 좋고 음식도 맛있대요."]
      }
    }
  ]
}

