{
  "chapter_id": "005",
  "cefr": "A2",
  "title_kr": "집과 방 묘사하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "방이 꽤 넓어요.,",
    "집이 아늑해요.,",
    "창문이 커서 좋아요.,",
    "조명이 따뜻해요.,",
    "정리가 잘 되어 있어요.,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "제 방 어때 보여요?",
          "맞아요, 창문이 커서 햇빛도 잘 들어요!",
          "저는 이 분위기가 참 마음에 들어요!"
        ],
        "B": [
          "오, 생각보다 넓어 보이네요!",
          "햇빛이 따뜻해서 더 좋아 보여요!",
          "응, 편안한 느낌이 딱 들어요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "제 책상이 너무 작은 것 같지 않아요?",
          "그쵸? 그래서 요즘 조금 불편해요.",
          "좀 더 큰 책상으로 바꿔볼까 해요!"
        ],
        "B": [
          "음… 조금 작은 느낌은 있네요!",
          "맞아요, 작업할 때 공간이 중요하죠!",
          "좋다! 그러면 더 편하게 쓰겠어요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "제 방 조명은 어떤 것 같아요?",
          "오! 따뜻한 색이라 더 편안하죠!",
          "이 조명 때문에 밤에 분위기가 좋아요!"
        ],
        "B": [
          "되게 아늑해 보여요!",
          "응, 눈도 편하고 보기 좋아요!",
          "맞아요! 방 분위기랑 잘 어울려요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "이 소파 편해 보이지 않아요?",
          "맞아요! 푹신해서 자꾸 눕게 돼요!",
          "주말엔 여기서 거의 보내요!"
        ],
        "B": [
          "응, 보기만 해도 편해 보여요!",
          "오~ 진짜 푹신해 보이네요!",
          "그렇겠어요! 완전 휴식 공간이네요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "제 방이 깔끔해 보이나요?",
          "오! 정리 잘돼 있죠?",
          "저는 이렇게 심플한 스타일을 좋아해요!"
        ],
        "B": [
          "응, 정말 잘 정돈돼 있어 보여요!",
          "맞아요! 보기만 해도 시원해요!",
          "심플한 스타일이랑 잘 어울리네요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "우리 집 거실은 좀 좁아 보이나요?",
          "아! 다행이에요! 그런 느낌이면 좋죠!",
          "그래도 조명 덕분에 더 넓어 보여요!"
        ],
        "B": [
          "음… 좁다기보단 아늑해 보여요!",
          "응! 분위기 괜찮아요!",
          "오~ 조명이 진짜 한몫하네요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "제 방 옷장이 너무 큰가요?",
          "오! 다행이네요! 너무 크면 답답할까 봤어요.",
          "그럼 지금 사이즈로 계속 쓰면 되겠어요!"
        ],
        "B": [
          "아니요! 방 크기랑 잘 맞아요!",
          "그렇죠? 공간을 딱 채워주는 느낌이에요!",
          "응! 보기에도 안정감 있어요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "이 방 향기 어떤 것 같아요?",
          "오, 맞아요! 은은해서 좋아요!",
          "그래서 요즘 방에 더 있고 싶어져요!"
        ],
        "B": [
          "되게 상쾌해요!",
          "응, 강하지 않아서 더 좋은 것 같아요!",
          "맞아요! 공간이 더 따뜻해져요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "제 방이 너무 심심해 보이나요?",
          "아! 좋은 생각이에요! 포스터 붙여볼까요?",
          "그럼 분위기가 확 달라지겠죠?"
        ],
        "B": [
          "조금 심플한 느낌은 있어요!",
          "응! 작은 장식만 있어도 달라져요!",
          "그렇죠! 더 따뜻해질 것 같아요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "이 집은 전체적으로 어떤 느낌이에요?",
          "오! 저도 그 부분이 가장 좋아요!",
          "앞으로 더 살고 싶어지는 집이에요!"
        ],
        "B": [
          "편안하고 아늑한 느낌이에요!",
          "응, 조용해서 더 매력 있어요!",
          "맞아요! 오래 살고 싶은 공간이에요!"
        ]
      },
      "tts_layer": {
        "A":{"tts_voice":"ko-KR-Standard-A"},
        "B":{"tts_voice":"ko-KR-Standard-B"}
      }
    }
  ]
