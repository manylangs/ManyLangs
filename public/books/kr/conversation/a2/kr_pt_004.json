{
  "chapter_id": "004",
  "cefr": "A2",
  "title_pt": "Marcar compromissos",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "Tens tempo?,",
    "Marcamos um encontro?,",
    "Esta semana funciona?,",
    "Essa hora dá-me jeito!,",
    "Diz-me outra vez a data.,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "Estás livre amanhã?",
          "Então… que tal às 14h?",
          "Perfeito! Vejo-te às 14h!"
        ],
        "B": [
          "Sim, amanhã tenho algum tempo!",
          "Ah, às 14h está ótimo!",
          "Combinado! Fica marcado!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "Tens um tempinho esta semana?",
          "Ah, ótimo! Essa hora dá-me jeito!",
          "Então encontramos-nos no café!"
        ],
        "B": [
          "Estou livre na sexta à tarde.",
          "Perfeito! Sexta está bem!",
          "Certo! Vejo-te no café!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "Podemos ajustar a nossa marcação para a próxima semana?",
          "Ah, ótimo! Quarta-feira dá-me jeito!",
          "Então vemos-nos à tarde!"
        ],
        "B": [
          "Sim, estou livre na próxima quarta.",
          "À tarde também me dá bem!",
          "Perfeito, já anoto isso!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "Conseguimos encontrar-nos hoje?",
          "Ah, que bom! Onde queres encontrar-te?",
          "Perfeito! Vou já para lá!"
        ],
        "B": [
          "Sim, estou disponível agora.",
          "Que tal o parque aqui perto?",
          "Ótimo! Vejo-te lá!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "Podemos reagendar a reunião?",
          "Então… às 16h está bem?",
          "Perfeito! Mudo para as 16h."
        ],
        "B": [
          "Sim, acho que devemos ajustar.",
          "Às 16h dá perfeitamente.",
          "Obrigado! Até lá!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "Posso marcar uma chamada?",
          "Ah, ótimo! Essa hora dá-me jeito!",
          "Então ligo-te nessa hora!"
        ],
        "B": [
          "Claro! 19h funciona para ti hoje?",
          "Perfeito, façamos às 19h!",
          "Está bem! Vou esperar pela tua chamada!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "Amanhã de manhã dá-te jeito?",
          "Ah, entendi! E de tarde?",
          "Perfeito! Vejo-te às 13h!"
        ],
        "B": [
          "De manhã tenho outra reunião.",
          "À tarde estou livre!",
          "Ótimo! Às 13h então!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "Quando nos encontramos outra vez?",
          "Então que tal no início da próxima semana?",
          "Ótimo! Vou reservar esse horário!"
        ],
        "B": [
          "Na próxima semana tenho mais disponibilidade.",
          "Segunda ou terça deve funcionar!",
          "Certo! Aviso-te assim que confirmar!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "Consegues atender uma chamada daqui a cinco minutos?",
          "Ah, ótimo!",
          "Então ligo-te dentro de cinco minutos!"
        ],
        "B": [
          "Sim! Só preciso terminar algo.",
          "Certo! Vou preparar-me!",
          "Perfeito! Fico à espera!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "Como correu o teu dia hoje?",
          "Ah, acontece! Fizeste o teu melhor!",
          "Espero que amanhã seja mais leve!"
        ],
        "B": [
          "Foi um pouco cansativo.",
          "Sim, mas agora estou melhor.",
          "Obrigado! Vou dar o meu melhor amanhã!"
        ]
      }
    }
  ]
}

