{
  "chapter_id": "002",
  "cefr": "A2",
  "title_kr": "취향과 선호",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "저는 이걸 더 좋아해요.,",
    "어떤 스타일 좋아하세요?,",
    "취향이 비슷하네요!,",
    "저는 가볍고 편한 게 좋아요.,",
    "이건 제 스타일이 아니어요.,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "저는 이런 밝은 색을 좋아하는데, 당신은 어떤 색 좋아하세요?",
          "오, 생각보다 취향이 비슷하네요!",
          "그럼 다음에 같이 쇼핑 가요!"
        ],
        "B": [
          "전 원래 파스텔톤을 좋아해요!",
          "맞아요! 색감 취향이 거의 같아요!",
          "좋아요! 그것도 재밌겠네요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "저는 단맛을 좋아하는데, 당신은 어때요?",
          "오! 저도 그 조합 좋아해요!",
          "그럼 나중에 같이 먹으러 가요!"
        ],
        "B": [
          "전 단맛보다 새콤한 걸 더 좋아해요!",
          "달콤하면서 상큼한 맛이 딱 좋죠!",
          "좋아요, 기대할게요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "저는 조용한 카페를 선호해요. 당신은요?",
          "오, 저도 너무 시끄러운 곳은 힘들더라고요.",
          "그럼 다음엔 조용한 곳으로 가요!"
        ],
        "B": [
          "저도 분위기 있는 카페가 좋아요.",
          "맞아요! 집중도 잘 되고 좋죠.",
          "좋아요, 제가 찾아볼게요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "저는 운동할 때 가벼운 음악을 듣는 걸 좋아해요.",
          "아! 그거 완전 공감돼요!",
          "그럼 추천 목록도 알려줄게요!"
        ],
        "B": [
          "저는 좀 더 신나는 음악을 좋아해요!",
          "운동할 때 리듬감 있는 음악이 딱이죠!",
          "좋아요! 공유해줘요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "저는 가볍고 편한 옷을 좋아해요.",
          "오, 저랑 스타일이 비슷하네요!",
          "그럼 저 브랜드도 좋아하실 것 같아요!"
        ],
        "B": [
          "저도 편한 스타일이 제일 좋아요!",
          "맞아요! 너무 막 꾸민 느낌은 별로예요.",
          "오! 한번 찾아볼게요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "저는 여행 갈 때 자연 풍경을 좋아해요.",
          "오, 저도 도시보다 자연을 더 좋아해요!",
          "그럼 같이 여행지 추천해요!"
        ],
        "B": [
          "저는 바다를 보면 기분이 너무 좋아져요.",
          "자연이 더 힐링 되죠!",
          "좋아요! 몇 곳 생각나는 데가 있어요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "저는 향이 강한 걸 별로 좋아하지 않아요.",
          "맞아요, 은은한 게 더 좋죠!",
          "그럼 그 브랜드 한번 써보세요!"
        ],
        "B": [
          "저도 너무 강한 향은 부담스러워요.",
          "센 향은 오래 맡으면 힘들더라고요.",
          "오! 추천해줘서 고마워요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "저는 영화는 가벼운 분위기가 좋아요.",
          "오, 저도 무거운 영화는 자주 못 보겠더라고요.",
          "그럼 코미디 추천해줄게요!"
        ],
        "B": [
          "저는 스릴러도 좋아하지만 분위기 가벼운 것도 좋아해요!",
          "맞아요! 편하게 보기엔 가벼운 영화가 최고죠.",
          "좋아요! 기대할게요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "저는 주말엔 집에서 쉬는 걸 좋아해요.",
          "그거 완전 공감돼요!",
          "그럼 다음 주엔 같이 쉬어요!"
        ],
        "B": [
          "저도 요즘은 집콕이 제일 좋더라고요.",
          "몸도 마음도 쉬어가는 느낌이죠!",
          "좋아요! 편하게 만나요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "저는 과한 장식은 별로 안 좋아해요.",
          "오, 저도 심플한 게 제일 좋더라고요!",
          "그럼 그 브랜드 한번 찾아보세요!"
        ],
        "B": [
          "맞아요, 너무 화려하면 부담돼요.",
          "심플한 디자인이 더 오래 써요!",
          "좋아요! 바로 검색해볼게요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    }
  ]
}

