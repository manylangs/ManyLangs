{
  "chapter_id": "010",
  "cefr": "A2",
  "title_kr": "도움 요청하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "잠깐 도와줄 수 있어요?",
    "방법을 모르겠어요",
    "시간 괜찮아요?",
    "고칠 수 있을까요?",
    "정말 고마워요"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "혹시 잠깐 도와줄 수 있어요?",
          "이 부분이 잘 안 돼서 계속 막히네요.",
          "시간 괜찮으면 조금만 봐주세요."
        ],
        "B": [
          "네, 뭐가 문제예요?",
          "아, 이런 문제 자주 나오죠.",
          "좋아요, 같이 보면 금방 해결될 거예요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "죄송한데 이거 어떻게 하는 거예요?",
          "설명서를 봐도 잘 모르겠어요.",
          "혹시 방법 알려줄 수 있어요?"
        ],
        "B": [
          "아, 이거 처음엔 헷갈려요.",
          "저도 처음엔 이해하는 데 시간 걸렸어요.",
          "천천히 알려줄게요. 금방 익숙해져요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "가방 지퍼가 고장 난 것 같아요.",
          "혼자 고치려니까 더 안 되는 것 같아요.",
          "혹시 봐줄 수 있어요?"
        ],
        "B": [
          "어, 어디가 고장 났어요?",
          "아, 조금 꼬였네요. 그래서 안 잠겼나 봐요.",
          "잠시만요, 이렇게 하면 다시 잘 돼요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "휴대폰이 갑자기 꺼졌어요.",
          "충전도 안 되는 것 같아요.",
          "혹시 왜 그런지 알아요?"
        ],
        "B": [
          "어, 많이 놀라셨겠어요.",
          "케이블이 문제일 수도 있어요.",
          "다른 충전기로도 한번 해보세요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "저기요, 길 좀 여쭤봐도 될까요?",
          "지도 앱이 계속 이상하게 떠요.",
          "혹시 이 근처 ○○역 아세요?"
        ],
        "B": [
          "네, 괜찮아요. 어디 찾으세요?",
          "아, 그 앱 가끔 오류 나요.",
          "○○역은 여기서 오른쪽으로 조금 가면 있어요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "컴퓨터가 갑자기 멈췄어요.",
          "아무리 눌러도 반응이 없어요.",
          "이럴 때 어떻게 해야 해요?"
        ],
        "B": [
          "어, 이런 거 당황스럽죠.",
          "일단 잠깐 껐다 켜보는 게 좋아요.",
          "그래도 안 되면 업데이트 문제일 수도 있어요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "짐이 너무 무거워서 들기 힘들어요.",
          "계단이 많아서 더 어렵네요.",
          "혹시 조금만 들어줄 수 있어요?"
        ],
        "B": [
          "네, 제가 도와드릴게요!",
          "맞아요, 계단에서 들기 정말 힘들어요.",
          "여기 내려놓으면 조금 쉬워질 거예요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "문이 잘 안 열려요.",
          "손잡이가 이상하게 느껴져요.",
          "혹시 확인 좀 해줄래요?"
        ],
        "B": [
          "어? 한번 열어볼게요.",
          "음, 손잡이가 조금 헐거워졌네요.",
          "고정시키면 금방 잘 열릴 거예요."
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "이거 어떻게 접는지 모르겠어요.",
          "계속 해봐도 모양이 안 나와요.",
          "혹시 한번 보여줄 수 있어요?"
        ],
        "B": [
          "네, 이거 처음엔 다들 어려워해요.",
          "접는 순서를 잘 기억해야 하거든요.",
          "이렇게 하면 모양이 제대로 잡혀요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "방금 떨어뜨렸는데, 이거 고칠 수 있을까요?",
          "겉은 괜찮아 보이는데 좀 불안해요.",
          "바쁘지 않으면 한번만 봐주세요."
        ],
        "B": [
          "어디 한번 볼게요.",
          "다행히 크게 깨진 데는 없네요.",
          "네, 이 정도면 고쳐서 계속 쓸 수 있어요!"
        ]
      },
      "tts_layer": { "A": {"tts_voice": "ko-KR-Standard-A"}, "B": {"tts_voice": "ko-KR-Standard-B"} }
    }
  ]
}

