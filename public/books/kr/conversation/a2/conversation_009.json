{
  "chapter_id": "009",
  "cefr": "A2",
  "title_kr": "건강과 증상",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "어디가 아파요?",
    "병원 가봤어요?",
    "좀 쉬어야 해요",
    "약 먹어봤어요?",
    "심하진 않아요"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "얼굴이 안 좋아 보여요. 어디 아파요?",
          "요즘 피곤해서 그런 것 같아요.",
          "그래도 병원 한번 가보는 게 좋을 것 같아요."
        ],
        "B": [
          "어제부터 머리가 좀 아파요.",
          "아, 피곤하면 머리도 아프죠.",
          "네, 시간 되면 한번 가보려고요."
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "기침 많이 하시네요. 감기예요?",
          "약은 좀 먹었어요?",
          "그럼 따뜻한 물 자주 드세요."
        ],
        "B": [
          "네, 목이 너무 따가워요.",
          "어제 감기약 먹었는데 아직 좀 남았어요.",
          "네, 물 마시면 조금 나아지는 것 같아요."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "요즘 허리가 계속 아파요.",
          "앉아 있을 때도 불편하더라고요.",
          "혹시 운동이 부족한 건가 싶어요."
        ],
        "B": [
          "허리 아프면 진짜 힘들죠.",
          "앉아만 있어도 통증 오면 일상이 불편하죠.",
          "가벼운 스트레칭부터 해보는 건 어때요?"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "오늘 배가 좀 아픈데 왜 그런지 모르겠어요.",
          "아침에 먹은 게 문제였나 싶어요.",
          "그래도 크게 심한 건 아닌 것 같아요."
        ],
        "B": [
          "속 안 좋을 때 진짜 괴롭죠.",
          "혹시 찬 거 드신 건 아니에요?",
          "네, 그래도 조심해서 오늘은 가볍게 드세요."
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "몸살 온 것 같아요. 온몸이 아프네요.",
          "기운도 하나도 없어요.",
          "오늘은 그냥 푹 쉬어야겠어요."
        ],
        "B": [
          "아이고, 몸살 오면 진짜 힘들죠.",
          "기운 없으면 아무것도 못 하죠.",
          "맞아요, 푹 자면 내일은 조금 나아질 거예요."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "아침부터 어지러워서 좀 걱정돼요.",
          "밥을 제대로 못 먹어서 그런가 봐요.",
          "일단 뭐라도 조금 먹어야겠어요."
        ],
        "B": [
          "어지러우면 위험해요.",
          "밥 못 먹으면 더 그렇게 느껴져요.",
          "네, 가볍게라도 드세요. 금방 나아질 거예요."
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "요즘 스트레스 때문인지 잠이 잘 안 와요.",
          "누우면 계속 생각이 많아져요.",
          "혹시 잠 잘 오는 방법 알아요?"
        ],
        "B": [
          "요즘 다들 잠 잘 못 자더라고요.",
          "생각 많아지면 잠들기 진짜 힘들죠.",
          "잠자기 전에 따뜻한 차 마시면 좀 도움이 돼요."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "아침부터 열이 좀 있는 것 같아요.",
          "몸이 뜨겁고 기운이 없어요.",
          "회사 가기엔 좀 힘들 것 같아요."
        ],
        "B": [
          "열 있으면 잘 쉬어야 해요.",
          "몸이 뜨거우면 아무것도 하기 어렵죠.",
          "오늘은 쉬고 내일 상태 보고 움직이세요."
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "손목이 요즘 자주 아파요.",
          "컴퓨터 오래 해서 그런가 봐요.",
          "스트레칭 좀 자주 해야겠어요."
        ],
        "B": [
          "손목 아프면 일하기도 힘들죠.",
          "오래 쓰면 확실히 무리 와요.",
          "네, 자주 풀어주면 통증도 많이 줄어요."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "점심 먹고 나서 속이 좀 더부룩해요.",
          "기름진 걸 먹어서 그런가 봐요.",
          "오늘은 소화 잘 되는 거 먹어야겠어요."
        ],
        "B": [
          "기름진 거 먹으면 속 불편할 때 많죠.",
          "맞아요, 오후 내내 무겁게 느껴져요.",
          "네, 저녁은 가볍게 드세요. 더 편할 거예요."
        ]
      }
    }
  ]
}

