{
  "chapter_id": "001",
  "cefr": "B2",
  "title_kr": "은행 업무",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "계좌 개설하려고 왔어요,",
    "신분증 보여드릴게요,",
    "수수료가 어떻게 되나요?,",
    "인터넷뱅킹도 신청할 수 있을까요?,",
    "해외 송금은 어떻게 하나요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "안녕하세요, 계좌를 새로 만들고 싶은데요.",
          "네, 그러면 필요한 서류가 뭐가 있을까요?",
          "아, 다행이네요. 그럼 지금 바로 진행할게요."
        ],
        "B": [
          "안녕하세요! 계좌 개설이요? 네, 바로 도와드릴게요.",
          "신분증만 있으면 바로 개설 가능하세요.",
          "좋습니다. 잠시만 기다려 주세요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "인터넷뱅킹도 같이 신청할 수 있나요?",
          "오, 생각보다 간단하네요!",
          "네, 그럼 자동이체도 설정하고 싶어요."
        ],
        "B": [
          "네, 계좌 개설하면서 함께 신청하실 수 있어요.",
          "네, 신청서만 작성하시면 바로 돼요.",
          "좋습니다. 자동이체 항목도 안내해 드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "해외 송금도 가능한 계좌인가요?",
          "아, 송금 제한이 있군요.",
          "그럼 한도 상향은 나중에 다시 신청할 수 있을까요?"
        ],
        "B": [
          "네, 해외 송금 가능합니다. 다만 한도는 기본 설정이 있어요.",
          "필요하시면 인증 단계를 추가로 진행하시면 돼요.",
          "물론입니다. 언제든지 신청 가능하세요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "체크카드도 같이 발급받을 수 있을까요?",
          "오, 택배로 받아볼 수 있군요.",
          "그럼 일단 신청해 주세요!"
        ],
        "B": [
          "네, 계좌 개설 후 바로 발급 신청 가능해요.",
          "네, 배송까지 보통 5일 정도 걸립니다.",
          "네, 지금 처리해드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },


    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "수수료는 어떻게 되나요?",
          "아, 일정 금액 유지하면 면제가 되는군요.",
          "그럼 최소 잔액은 유지해야겠네요!"
        ],
        "B": [
          "일반 계좌는 기본 이체 수수료가 있어요.",
          "네, 일정 잔고를 유지하시면 면제됩니다.",
          "맞아요, 그게 가장 효율적이에요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "오늘 바로 통장도 받을 수 있나요?",
          "오, 금방 나오네요!",
          "좋아요. 조금만 기다릴게요."
        ],
        "B": [
          "네, 현장에서 바로 발급해 드려요.",
          "네, 출력은 1~2분이면 됩니다.",
          "곧 불러드릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 자동이체 내역을 확인할 수 있을까요?",
          "오, 그 메뉴는 못 봤네요.",
          "좋아요. 집에 가서 다시 확인해볼게요."
        ],
        "B": [
          "네, 앱에서 조회 가능하세요.",
          "‘계좌 관리’ 화면에 들어가면 바로 보입니다.",
          "네, 어려우면 다시 문의 주세요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "최근 거래내역을 출력하고 싶은데요.",
          "네, 한 달치면 충분해요!",
          "좋아요. 감사합니다!"
        ],
        "B": [
          "네, 몇 개월치가 필요하세요?",
          "그럼 최근 한 달 거래내역 출력해 드릴게요.",
          "잠시만 기다려 주세요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "모바일 OTP로 변경하고 싶은데 가능한가요?",
          "오, 그럼 훨씬 편하겠어요!",
          "좋아요. 바로 신청할게요."
        ],
        "B": [
          "네, 요즘은 모바일 OTP를 많이 사용하세요.",
          "설치만 하시면 바로 인증이 돼요.",
          "네, 필요한 단계 안내해 드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "혹시 대기 시간이 길까요?",
          "아, 다행이에요. 급한 일정이 있어서요.",
          "좋아요. 그럼 조금만 기다릴게요."
        ],
        "B": [
          "지금은 비교적 빨리 진행되고 있어요.",
          "금방 안내해 드릴 수 있을 것 같아요.",
          "편하게 앉아서 기다리시면 됩니다!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }

  ]
}

