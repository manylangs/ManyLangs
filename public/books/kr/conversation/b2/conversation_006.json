{
  "chapter_id": "006",
  "cefr": "B2",
  "title_kr": "숙소 예약하기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "예약 가능할까요?,",
    "체크인 시간이 어떻게 되나요?,",
    "더블룸으로 부탁드려요.,",
    "남는 방이 있을까요?,",
    "가격이 어떻게 되나요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 이번 주말에 묵을 방이 있을까요?",
          "토요일 오후에 체크인할 예정이에요.",
          "편하게 지낼 수 있는 더블룸이 있을까요?"
        ],
        "B": [
          "안녕하세요! 날짜만 알려주시면 확인해드릴게요.",
          "네, 그 시간대는 가능합니다! 침대 타입도 선택하실 수 있어요.",
          "네, 더블룸 가능합니다! 예약 도와드릴까요?"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 조식 포함된 방도 있나요?",
          "좋네요! 조식 포함이면 더 편하겠어요.",
          "가격이 어느 정도인지 알려주실 수 있을까요?"
        ],
        "B": [
          "네 있어요! 조식 포함 옵션이 요즘 인기가 많아요.",
          "네, 조식 시간도 넉넉해서 부담 없이 드실 수 있어요.",
          "더블룸 기준으로 일박에 구만 원입니다."
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "체크인 시간은 몇 시부터 가능한가요?",
          "좋네요. 도착 시간이랑 잘 맞을 것 같아요.",
          "늦게 도착해도 괜찮을까요?"
        ],
        "B": [
          "오후 세시부터 체크인 가능하십니다.",
          "네, 그럼 여유 있게 오시면 되겠어요!",
          "네, 미리만 알려주시면 문제없어요."
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "주차장은 따로 이용할 수 있나요?",
          "와, 무료면 너무 좋네요!",
          "그럼 체크인할 때 안내받으면 되나요?"
        ],
        "B": [
          "네, 투숙객은 무료로 이용 가능하세요.",
          "맞아요! 대부분 편하게 이용하시더라고요.",
          "네, 프런트에서 안내 도와드릴게요."
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 창문이 큰 방도 있나요?",
          "오 좋은데요! 채광이 중요해서요.",
          "그 방으로 예약하고 싶어요."
        ],
        "B": [
          "네, 전망 좋은 방 하나 남아 있어요.",
          "네, 해가 잘 들어서 손님들 만족도가 높아요.",
          "좋습니다! 그 방으로 처리해드릴게요."
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "혹시 흡연실도 있나요?",
          "아 그렇군요. 그럼 금연실 괜찮아요!",
          "창가 쪽 자리면 더 좋을 것 같아요."
        ],
        "B": [
          "현재는 전 객실 금연 정책입니다.",
          "네! 금연실이 더 깔끔해서 많이 선택하세요.",
          "네, 가능한 방 중에서 최대한 반영해드릴게요."
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "혹시 반려동물과 함께 묵을 수 있을까요?",
          "아, 소형견만 가능한 거군요!",
          "그럼 규정만 잘 지키면 되는 거죠?"
        ],
        "B": [
          "네, 소형견은 가능하십니다.",
          "맞아요! 추가 요금도 크지 않아요.",
          "네, 체크인 때 안내 드리는 규칙만 지켜주시면 됩니다."
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
            "결제는 현장 결제도 가능한가요?",
            "좋네요! 그럼 체크인할 때 결제할게요.",
            "혹시 취소 정책도 알려주실 수 있나요?"
        ],
        "B": [
            "네, 현장 결제 또는 사전 결제 둘 다 가능합니다.",
            "네! 그게 가장 편하실 거예요.",
            "하루 전까지는 무료 취소 가능합니다."
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
            "방에 욕실은 개별로 있나요?",
            "아, 개인 욕실이면 충분해요.",
            "어메니티도 기본 제공되는 거죠?"
        ],
        "B": [
            "네, 모든 객실에 개별 욕실이 있습니다.",
            "넵! 다들 편하게 이용하세요.",
            "네, 기본 세트는 모두 들어가 있습니다."
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
            "그럼 예약 확정해주실 수 있을까요?",
            "좋아요! 문자로 받으면 편하겠어요.",
            "감사합니다! 기대되네요."
        ],
        "B": [
            "네, 지금 바로 확정해드릴게요.",
            "확인 문자 보내드릴게요. 도착하면 바로 알려주세요!",
            "좋은 여행 되세요!"
        ]
      }
    }
  ]
}

