  "title_kr": "쇼핑 세부 표현",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "사이즈 있나요?,",
    "입어봐도 되나요?,",
    "다른 색도 있나요?,",
    "교환 가능한가요?,",
    "재고가 있나요?,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "이 옷 사이즈가 있을까요?",
          "오 잘 맞을 것 같은데요!",
          "그럼 이걸로 해볼게요."
        ],
        "B": [
          "네, 잠시만요! 뒤에 창고도 한번 찾아볼게요.",
          "맞아요, 핏도 예쁘게 떨어져요.",
          "좋아요! 계산대에서 바로 도와드릴게요."
        ]
      }
    },
    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 입어봐도 되나요?",
          "오 생각보다 편하네요!",
          "그럼 이 사이즈가 제일 낫겠어요."
        ],
        "B": [
          "물론이죠! 피팅룸 오른쪽으로 가시면 돼요.",
          "맞죠? 신축성도 좋아요.",
          "네, 그 사이즈가 가장 자연스러워 보여요."
        ]
      }
    },
    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "다른 색상도 있나요?",
          "오 이 색도 괜찮다!",
          "그럼 이 색으로 할게요."
        ],
        "B": [
          "네, 지금 검정이랑 연한 베이지 두 가지 더 있어요.",
          "확실히 피부 톤이랑도 잘 어울려요.",
          "좋아요! 포장해드릴까요?"
        ]
      }
    },
    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 소재는 어떤가요?",
          "오 부드럽고 가볍네요!",
          "여름에도 잘 입겠어요."
        ],
        "B": [
          "면이랑 레이온 혼방이라 통기성이 좋아요.",
          "맞아요! 착용감도 되게 가볍죠?",
          "네, 더운 날에도 부담 없이 입을 수 있어요."
        ]
      }
    },
    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "혹시 교환이나 환불도 가능한가요?",
          "오 영수증만 있으면 되는군요!",
          "그럼 포장만 예쁘게 부탁드려요."
        ],
        "B": [
          "네, 칠일 이내면 교환·환불 모두 가능해요.",
          "맞아요! 라벨만 제거되지 않으면 돼요.",
          "물론이죠! 선물용으로도 포장해드릴게요."
        ]
      }
    },
    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "혹시 할인 중인 상품도 있어요?",
          "오 이게 할인 제품이군요!",
          "가격 대비 퀄리티가 좋네요."
        ],
        "B": [
          "네, 왼쪽 매대가 오늘 이십퍼센트 할인이에요.",
          "맞아요! 이 디자인이 특히 인기 많아요.",
          "그쵸? 그래서 재고가 빨리 빠지고 있어요."
        ]
      }
    },
    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "재고가 많이 남아있나요?",
          "아 그러면 빨리 결정해야겠네요.",
          "그럼 지금 바로 구매할게요."
        ],
        "B": [
          "이 디자인은 거의 다 나가서 몇 개 안 남았어요.",
          "맞아요! 오후 되면 품절될 수도 있어요.",
          "좋아요! 직원분께 바로 가져다드릴게요."
        ]
      }
    },
    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "혹시 세탁은 어떻게 해야 해요?",
          "오 손세탁이면 크게 어렵진 않겠네요.",
          "그럼 오래 잘 입을 수 있겠어요."
        ],
        "B": [
          "찬물에 손세탁 추천드리고, 건조기는 피해주세요.",
          "네, 그렇게 하면 변형도 거의 없어요.",
          "맞아요! 형태만 잘 잡아서 말리면 돼요."
        ]
      }
    },
    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "이거는 신상인가요?",
          "오 그래서 디자인이 더 세련됐군요!",
          "그럼 빨리 품절되기 전에 사야겠네요."
        ],
        "B": [
          "네, 이번 주에 막 들어온 신상이에요.",
          "맞아요! 이번 시즌 컨셉이랑 잘 어울려요.",
          "그래서 벌써 반 정도는 나갔어요."
        ]
      }
    },
    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "그럼 결제하고 가면 될까요?",
          "오 포인트도 적립되네요!",
          "감사합니다! 좋은 하루 되세요."
        ],
        "B": [
          "네, 계산대에서 바로 결제 가능해요.",
          "네! 포인트 적립도 자동으로 돼요.",
          "감사합니다! 다음에 또 들러주세요."
        ]
      }
    }
  ]
