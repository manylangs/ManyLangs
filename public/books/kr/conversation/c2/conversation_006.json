{
  "chapter_id": "006",
  "cefr": "C2",
  "title_kr": "데이터와 분석",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "데이터 패턴을 확인하다,",
    "지표 변화를 분석하다,",
    "샘플 크기를 늘리다,",
    "추세를 예측하다,",
    "모델 정확도를 검증하다,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "어제 보낸 데이터셋 검토해보셨나요?",
          "그럼 그래프에서 가장 큰 변동 구간 보이셨죠?",
          "저는 그 부분이 캠페인 영향이라고 생각해요."
        ],
        "B": [
          "봤어요! 변동 구간이 꽤 뚜렷하더라고요.",
          "응, 그 지점이 특히 눈에 띄었어요.",
          "좋아요, 그럼 해당 기간을 중심으로 추가 분석해볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "이번 결과에서 예측 오차가 좀 줄었더라고요.",
          "하이퍼파라미터 조정이 꽤 효과 있었나 봐요.",
          "그럼 한 번 더 최적값 범위를 좁혀볼까요?"
        ],
        "B": [
          "맞아요, 그래프가 훨씬 안정적이에요.",
          "네, 조정 전보다 모델이 훨씬 깔끔해졌어요.",
          "좋아요, 그 범위 중심으로 다시 테스트해보죠."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "데이터 노이즈가 조금 심한 것 같지 않아요?",
          "필터링 조건을 더 엄격하게 가져가야 할 것 같아요.",
          "그렇게 하면 패턴이 더 또렷해질 거예요."
        ],
        "B": [
          "저도 그렇게 느꼈어요. 그래프가 좀 흐려 보였죠.",
          "좋아요, 그 조건 한번 적용해볼게요.",
          "네, 그럼 다시 한번 샘플링해서 공유할게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 이번 분석에 상관관계 지표도 넣어봤나요?",
          "특히 2번 변수랑 5번 변수가 신경 쓰이더라고요.",
          "상관값이 높으면 모델에 반영해봐도 좋겠어요."
        ],
        "B": [
          "넣어봤어요! 둘 사이가 꽤 강하게 연결돼 있더라고요.",
          "맞아요, 그 두 변수가 특히 흥미로웠어요.",
          "좋아요, 그럼 이번 버전에 반영해볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "데이터 포맷 통일은 다 끝났나요?",
          "이제 모델에 그대로 넣어도 문제 없을 것 같아요.",
          "그럼 바로 다음 단계로 넘어갈게요."
        ],
        "B": [
          "네, 모든 컬럼 형식을 맞춰놨어요.",
          "응, 이제 전처리 걱정은 안 해도 될 것 같아요.",
          "좋아요, 그럼 실행 로깅도 켜둘게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "이번엔 테스트 데이터도 좀 더 크게 가져가보죠?",
          "표본 수가 늘면 신뢰도가 높아질 거예요.",
          "그럼 2배 정도로 늘리는 건 어떠세요?"
        ],
        "B": [
          "좋아요, 더 큰 데이터가 필요하긴 했어요.",
          "맞아요, 신뢰도에도 확실히 도움 될 거예요.",
          "2배면 충분해 보여요. 바로 적용할게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "지금 추세선 보니까 다음 주에 변동 클 것 같아요.",
          "특히 주말 이후에 확 꺾이는 지점이 보여요.",
          "그 전에 대응 전략을 세우는 게 좋겠네요."
        ],
        "B": [
          "저도 그 부분이 제일 눈에 띄었어요.",
          "맞아요, 예측선이 거기서 크게 바뀌죠.",
          "좋아요, 내일까지 전략안 초안 만들어볼게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "이번 모델 정확도 검증 결과 괜찮게 나왔나요?",
          "지난번보다 오차 범위가 줄었으면 좋겠어요.",
          "그럼 최종 검증만 더 진행해볼까요?"
        ],
        "B": [
          "네, 지난번보다 훨씬 안정적이었어요.",
          "오차도 꽤 줄어서 더 신뢰할 수 있어 보여요.",
          "좋아요, 남은 검증도 제가 처리할게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "혹시 대시보드 시각화도 업데이트하셨나요?",
          "이번엔 사용자 흐름도 추가하면 좋을 것 같아요.",
          "그럼 업데이트 버전 나오면 바로 확인해볼게요."
        ],
        "B": [
          "했어요! 기본 지표는 다 반영해놨어요.",
          "좋아요, 사용자 흐름도 바로 넣어볼게요.",
          "완성되면 바로 공유드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },
    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "마지막으로 전체 데이터 품질 점검만 하면 되겠네요.",
          "누락값만 잘 처리되면 문제 없을 것 같아요.",
          "그럼 점검 끝나는 대로 보고드릴게요."
        ],
        "B": [
          "맞아요, 이제 거의 다 왔어요!",
          "네, 누락값만 잡으면 안정적일 거예요.",
          "좋아요, 결과 기다릴게요!"
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

