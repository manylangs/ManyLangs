{
  "chapter_id": "006",
  "cefr": "C1",
  "title_kr": "고객 커뮤니케이션",
  "title_learner": "",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "자료 한번 확인 부탁드립니다,",
    "업데이트된 내용 공유드립니다,",
    "추가 요청 있으시면 알려주세요,",
    "일정 다시 조율 가능하십니까?,",
    "검토 후 피드백 기다리겠습니다,"
  ],

  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "안녕하세요! 지금 잠깐 이야기 가능하실까요?",
          "지난번 요청하신 수정 사항은 거의 반영됐습니다.",
          "우선 초안 파일 보내드릴게요."
        ],
        "B": [
          "네, 지금 가능합니다. 어떤 내용인가요?",
          "오, 좋네요! 어떤 부분이 특히 바뀌었나요?",
          "좋습니다. 바로 확인해보고 의견 드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "혹시 지난 자료 검토해보셨나요?",
          "말씀 주신 문구는 자연스럽게 다시 정리했습니다.",
          "필요하시면 버전 2도 바로 준비할 수 있어요."
        ],
        "B": [
          "네, 전체적으로 잘 봤습니다!",
          "오, 그 부분이 훨씬 더 명확해졌네요.",
          "좋아요. 그러면 다음 단계도 진행해 주세요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "요청하신 추가 표는 오늘 안으로 완성됩니다.",
          "데이터 흐름이 잘 보이도록 구조도 조금 조정했습니다.",
          "괜찮으시면 그 부분도 함께 검토 부탁드릴게요."
        ],
        "B": [
          "오, 감사합니다. 생각보다 빠르네요!",
          "좋아요. 구조 조정된 부분이 특히 기대되네요.",
          "네, 검토 후 바로 피드백 드리겠습니다."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 일정 다시 조율이 가능할까요?",
          "내부 확인 결과 하루 정도는 더 필요할 것 같습니다.",
          "불편드려 죄송합니다."
        ],
        "B": [
          "네, 일정 여유가 조금 있으니 괜찮습니다.",
          "그렇군요. 추가 시간이 필요한 이유 이해됩니다.",
          "편하게 진행해 주세요. 마감만 맞으면 문제 없습니다."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "업데이트된 디자인 한번 확인해보시겠어요?",
          "색감과 구성은 요청하신 방향으로 맞췄습니다.",
          "다른 톤의 버전도 필요하시면 말씀 주세요."
        ],
        "B": [
          "오, 지금 바로 볼게요!",
          "네, 훨씬 깔끔하고 보기 좋네요.",
          "좋아요. 다른 톤도 있으면 비교해보고 싶습니다."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "지난번 피드백 중 강조하고 싶으셨던 부분 맞나요?",
          "그 포인트는 훨씬 더 명확하게 수정했습니다.",
          "추가 의견 있으시면 바로 반영하겠습니다."
        ],
        "B": [
          "네, 바로 그 부분입니다!",
          "지금 보니 메시지가 훨씬 명확해졌네요.",
          "좋습니다. 그 방향으로 계속 진행해 주세요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "파일 크기가 조금 커졌는데 괜찮으실까요?",
          "이미지 품질을 유지하려다 보니 그렇게 됐습니다.",
          "필요하시면 최적화 버전도 제작할 수 있습니다."
        ],
        "B": [
          "아, 그렇군요. 괜찮습니다!",
          "품질 유지가 더 중요하니까요.",
          "하지만 최적화 버전도 하나 있으면 좋을 것 같아요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "혹시 회의 전에 간단한 요약본이 필요하실까요?",
          "발표용으로 쓰기 좋게 1페이지로 만들 수 있습니다.",
          "원하시면 바로 제작해드릴게요."
        ],
        "B": [
          "오, 그거 정말 도움이 되겠네요!",
          "1페이지 요약이면 회의 준비가 훨씬 수월하겠습니다.",
          "네, 부탁드립니다. 공유해 주시면 바로 검토할게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "어제 보내드린 버전은 문제없이 열리셨나요?",
          "파일 호환성 때문에 혹시 에러가 있을까 걱정됐습니다.",
          "필요하면 다른 확장자로도 변환해드릴게요."
        ],
        "B": [
          "네, 잘 열립니다! 문제 없었어요.",
          "걱정해 주셔서 감사합니다.",
          "다른 확장자도 있으면 좋겠지만 지금은 이대로 괜찮습니다."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "이번 주 안에 최종본을 전달드릴 예정입니다.",
          "내부 검수가 끝나는 대로 바로 보내드리겠습니다.",
          "혹시 마감 관련해서 조정이 필요하시면 말씀 주세요."
        ],
        "B": [
          "네, 일정 공유 감사합니다!",
          "내부 검수만 지나면 거의 마무리군요.",
          "알겠습니다. 변경 사항 생기면 바로 알려드릴게요."
        ]
      },
      "tts_layer": {
        "A": { "tts_voice": "ko-KR-Standard-A" },
        "B": { "tts_voice": "ko-KR-Standard-B" }
      }
    }
  ]
}

