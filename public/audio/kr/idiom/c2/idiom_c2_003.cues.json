[
  {
    "index": 1,
    "text": "속이 울먹이다",
    "start": 0.0,
    "end": 2.3
  },
  {
    "index": 2,
    "text": "감정이 북받쳐 울음이 터질 듯한 상태이다.",
    "start": 2.3,
    "end": 4.6
  },
  {
    "index": 3,
    "text": "그 말을 들으니 속이 울먹인다.",
    "start": 4.6,
    "end": 6.9
  },
  {
    "index": 4,
    "text": "추억을 떠올리자 속이 울먹였다.",
    "start": 6.9,
    "end": 9.2
  },
  {
    "index": 5,
    "text": "속이 울먹일 때는 감정을 숨기기 어렵다.",
    "start": 9.2,
    "end": 11.5
  },
  {
    "index": 6,
    "text": "아… 울먹인다.",
    "start": 11.5,
    "end": 13.8
  },
  {
    "index": 7,
    "text": "속이 울먹이면 눈물이 난다.",
    "start": 13.8,
    "end": 16.1
  },
  {
    "index": 8,
    "text": "마음이 덜컥하다",
    "start": 16.1,
    "end": 18.4
  },
  {
    "index": 9,
    "text": "갑작스러운 놀람이나 불안으로 마음이 철렁 내려앉는 느낌이다.",
    "start": 18.4,
    "end": 20.7
  },
  {
    "index": 10,
    "text": "전화벨이 울려서 마음이 덜컥했다.",
    "start": 20.7,
    "end": 23.0
  },
  {
    "index": 11,
    "text": "문제를 보고 마음이 덜컥했다.",
    "start": 23.0,
    "end": 25.3
  },
  {
    "index": 12,
    "text": "마음이 덜컥하면 정신을 차리기 어렵다.",
    "start": 25.3,
    "end": 27.6
  },
  {
    "index": 13,
    "text": "아… 깜짝 놀랐네.",
    "start": 27.6,
    "end": 29.9
  },
  {
    "index": 14,
    "text": "마음이 덜컥하면 무섭다.",
    "start": 29.9,
    "end": 32.21
  },
  {
    "index": 15,
    "text": "속이 방망이질하다",
    "start": 32.21,
    "end": 34.51
  },
  {
    "index": 16,
    "text": "두근거림이나 긴장으로 속이 쿵쾅거리는 느낌이다.",
    "start": 34.51,
    "end": 36.81
  },
  {
    "index": 17,
    "text": "기다리느라 속이 방망이질한다.",
    "start": 36.81,
    "end": 39.11
  },
  {
    "index": 18,
    "text": "면접장 앞에서 속이 방망이질했다.",
    "start": 39.11,
    "end": 41.41
  },
  {
    "index": 19,
    "text": "속이 방망이질하면 호흡을 가다듬는 것이 좋다.",
    "start": 41.41,
    "end": 43.71
  },
  {
    "index": 20,
    "text": "아… 심장 터질 것 같아.",
    "start": 43.71,
    "end": 46.01
  },
  {
    "index": 21,
    "text": "속이 방망이질하면 긴장된다.",
    "start": 46.01,
    "end": 48.31
  },
  {
    "index": 22,
    "text": "마음이 두근두근하다",
    "start": 48.31,
    "end": 50.61
  },
  {
    "index": 23,
    "text": "기대감이나 긴장으로 가슴이 빠르게 뛰는 상태이다.",
    "start": 50.61,
    "end": 52.91
  },
  {
    "index": 24,
    "text": "좋은 소식에 마음이 두근두근한다.",
    "start": 52.91,
    "end": 55.21
  },
  {
    "index": 25,
    "text": "데이트 전이라 마음이 두근두근했다.",
    "start": 55.21,
    "end": 57.51
  },
  {
    "index": 26,
    "text": "마음이 두근두근하면 웃음이 난다.",
    "start": 57.51,
    "end": 59.81
  },
  {
    "index": 27,
    "text": "아… 두근거린다.",
    "start": 59.81,
    "end": 62.11
  },
  {
    "index": 28,
    "text": "마음이 두근두근하면 기대된다.",
    "start": 62.11,
    "end": 64.41
  },
  {
    "index": 29,
    "text": "속이 바짝바짝 타다",
    "start": 64.41,
    "end": 66.71
  },
  {
    "index": 30,
    "text": "걱정이나 긴장으로 속이 타들어가는 듯한 느낌이다.",
    "start": 66.71,
    "end": 69.01
  },
  {
    "index": 31,
    "text": "결과가 걱정돼서 속이 바짝바짝 탄다.",
    "start": 69.01,
    "end": 71.31
  },
  {
    "index": 32,
    "text": "연락이 안 와서 속이 바짝 탔다.",
    "start": 71.31,
    "end": 73.61
  },
  {
    "index": 33,
    "text": "속이 바짝 타면 실수하기 쉽다.",
    "start": 73.61,
    "end": 75.91
  },
  {
    "index": 34,
    "text": "아… 속 타 죽겠다.",
    "start": 75.91,
    "end": 78.21
  },
  {
    "index": 35,
    "text": "속이 타면 걱정이 많다.",
    "start": 78.21,
    "end": 80.51
  }
]