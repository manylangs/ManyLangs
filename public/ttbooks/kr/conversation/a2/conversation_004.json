{
  "chapter_id": "004",
  "cefr": "A2",
  "title_kr": "약속 잡기",
  "speaker_label_removed": true,
  "voice_validation_required": true,
  "key_expressions": [
    "시간 괜찮으세요?,",
    "약속 잡을까요?,",
    "이번 주는 어때요?,",
    "그 시간 가능해요!,",
    "날짜 다시 알려주세요.,"
  ],
  "sets": [
    {
      "set_id": 1,
      "dialogue_layer": {
        "A": [
          "내일 시간 괜찮으세요?",
          "그럼 오후 두 시는 어때요?",
          "좋아요! 두 시에 뵐게요!"
        ],
        "B": [
          "네, 내일은 좀 여유 있어요!",
          "오, 두 시 딱 좋아요!",
          "네, 약속해요!"
        ]
      }
    },

    {
      "set_id": 2,
      "dialogue_layer": {
        "A": [
          "이번 주에 잠깐 시간 괜찮으세요?",
          "오! 그 시간 좋아요!",
          "그럼 카페에서 만나요!"
        ],
        "B": [
          "금요일 오후는 비어 있어요.",
          "좋아요! 금요일로 해요!",
          "네, 카페에서 봬요!"
        ]
      }
    },

    {
      "set_id": 3,
      "dialogue_layer": {
        "A": [
          "다음 주에 일정 조율할 수 있을까요?",
          "오, 수요일 괜찮아요!",
          "그럼 오후에 만나는 걸로 할게요!"
        ],
        "B": [
          "네! 다음 주 수요일 비어 있어요.",
          "저도 오후가 좋네요!",
          "좋아요! 일정 잡아둘게요!"
        ]
      }
    },

    {
      "set_id": 4,
      "dialogue_layer": {
        "A": [
          "혹시 오늘 바로 만날 수 있을까요?",
          "오! 다행이에요! 그럼 어디에서 볼까요?",
          "좋아요! 지금 바로 갈게요!"
        ],
        "B": [
          "네! 지금은 괜찮아요.",
          "근처 공원은 어때요?",
          "좋아요! 거기서 봐요!"
        ]
      }
    },

    {
      "set_id": 5,
      "dialogue_layer": {
        "A": [
          "회의 일정 다시 잡을 수 있을까요?",
          "그럼 네시 괜찮으세요?",
          "좋아요! 네시로 변경할게요."
        ],
        "B": [
          "네, 조금 조정해야 할 것 같아요.",
          "네시면 충분해요!",
          "감사해요! 그때 봬요!"
        ]
      }
    },

    {
      "set_id": 6,
      "dialogue_layer": {
        "A": [
          "전화 상담 예약 가능할까요?",
          "오! 그 시간 괜찮아요!",
          "그럼 그때 연락드릴게요!"
        ],
        "B": [
          "네! 오늘 저녁 일곱 시는 괜찮아요?",
          "좋아요! 일곱 시로 할게요!",
          "네, 기다릴게요!"
        ]
      }
    },

    {
      "set_id": 7,
      "dialogue_layer": {
        "A": [
          "내일 오전도 괜찮으세요?",
          "오! 오후도 괜찮아요!",
          "그럼 오후 한 시에 뵐게요!"
        ],
        "B": [
          "오전엔 회의가 있어요.",
          "오후는 비어 있어요!",
          "좋아요! 오후 한 시에 만나요!"
        ]
      }
    },

    {
      "set_id": 8,
      "dialogue_layer": {
        "A": [
          "다음에 언제 다시 만날까요?",
          "그럼 다음 주 초는 어때요?",
          "좋아요! 일정 잡아둘게요!"
        ],
        "B": [
          "저는 다음 주가 더 여유 있어요.",
          "월요일이나 화요일이 괜찮아요!",
          "네! 정해지면 알려드릴게요!"
        ]
      }
    },

    {
      "set_id": 9,
      "dialogue_layer": {
        "A": [
          "혹시 오분 뒤에 통화 가능하세요?",
          "오! 다행이에요!",
          "그럼 오분 뒤에 전화드릴게요!"
        ],
        "B": [
          "네! 지금 정리만 하면 돼요.",
          "좋아요! 준비해둘게요!",
          "네, 기다릴게요!"
        ]
      }
    },

    {
      "set_id": 10,
      "dialogue_layer": {
        "A": [
          "오늘 일정 괜찮으셨어요?",
          "오, 그럴 수 있죠! 고생 많으셨어요!",
          "그럼 내일은 조금 더 여유 있길 바랄게요!"
        ],
        "B": [
          "네, 조금 정신없었어요.",
          "맞아요, 그래도 괜찮아요!",
          "감사해요! 내일 더 힘낼게요!"
        ]
      }
    }
  ]
}

