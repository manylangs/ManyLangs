#!/usr/bin/env python3

import copy
import json
import sys
from pathlib import Path

############################################################
# 기본 경로
############################################################

DATA_DIR = Path(
    "/Users/junghasuk/Desktop/ManyLangs/web/firebase/"
    "voca generator/data"
)

############################################################
# batch_id 매핑 참고
#
# data/001~024 = a1 (001~024)
# data/025~048 = a2 (001~024)
# data/049~072 = b1 (001~024)
# data/073~096 = b2 (001~024)
# data/097~120 = c1 (001~024)
# data/121~144 = c2 (001~024)
#
# batch_id는 폴더 번호(001~144) 단일 연번이며,
# 실제 파일은 data/{batch_id}/data.json 이다.
# (resolve_json_file()이 실제로 여는 경로는 이 data.json이며,
#  이 스크립트는 그 경로만 사용한다. "voca_{batch_id}.runtime.json"
#  같은 이름은 실제로 존재하지 않으므로 아래 주석/설명에서도 쓰지 않는다.)
############################################################

############################################################
# 이 스크립트는 KR-target 데이터와 EN-target 데이터 모두에
# 공용으로 사용한다.
#
# - KR-target 배치: target=한국어, kr은 target의 미러, 나머지
#   7개(en/es/fr/pt/jp/zh + kr 자기 자신)가 교정 대상.
# - EN-target 배치: target=영어, en은 target의 미러, 나머지
#   7개(kr/es/fr/pt/jp/zh + en 자기 자신)가 교정 대상.
#
# 즉 어느 타겟이든 "target을 제외한 7개 언어 키"가 교정 가능
# 범위이며, 그중 미러 언어(en 또는 kr)는 target과 완전히 동일한
# 값으로만 고칠 수 있다는 제약이 검수프롬프트 단계에서 걸린다
# (이 스크립트 자체는 그 제약을 강제하지 않는다 — 검수프롬프트가
# 이미 그 규칙을 지켜서 출력한다고 가정한다).
############################################################

############################################################
# 실제 voca JSON 스키마 (Manual A v2.0 기준)
#
# {
#   "meta": {"series": "vocabulary", "level": "a1", "id": "001"},
#   "title": {"target": "...", "en": "...", "es": "...", ...},
#   "blocks": [
#     {
#       "id": "block_001",
#       "word": {
#         "target": {"core": "...", "meaning_zone": ["...", ...]},
#         "en":     {"core": "...", "meaning_zone": ["...", ...]},
#         ... (8개 언어 전부 동일한 {core, meaning_zone} 구조)
#       },
#       "examples": [
#         {"target": "...", "en": "...", ...},   # 1) declarative
#         {"target": "...", "en": "...", ...},   # 2) negative
#         {"target": "...", "en": "...", ...},   # 3) question
#       ]
#     },
#     ... (block_002 ~ block_005)
#   ]
# }
#
# word는 언어별로 {core, meaning_zone} "객체"이고,
# examples는 언어별로 그냥 "문자열"이다. 이 둘의 교체 형식이
# 서로 다르므로 WORD_REPLACEMENTS와 EXAMPLE_REPLACEMENTS는
# value 타입이 다르다.
############################################################

############################################################
# 수정할 항목만 입력 (voca_kr_검수프롬프트_v2.md /
# voca_en_검수프롬프트_v2.md의 출력을 그대로 여기에 붙여넣는다)
#
# ALL_REPLACEMENTS 형식:
#   "001": {
#       "TITLE_REPLACEMENTS": {"언어": "수정된 제목", ...},
#
#       "WORD_REPLACEMENTS": {
#           ("block_id", "언어"): {
#               "core": "수정된 core",
#               "meaning_zone": ["수정된 표현1", "수정된 표현2", ...],
#           },
#           ...
#       },
#
#       "EXAMPLE_REPLACEMENTS": {
#           ("block_id", example_index, "언어"): "수정된 예문",
#           ...
#       },
#   },
#   "002": {...},
#   ...
#
# 바깥쪽 키("001", "002" ...)는 batch_id이며, data/{batch_id}/data.json
# 파일을 가리킨다.
#
# WORD_REPLACEMENTS의 value는 항상 {"core": str, "meaning_zone": [str,...]}
# 객체다. core만 고치고 meaning_zone은 그대로 두고 싶어도, meaning_zone
# 전체를 다시 써서 넣어야 한다 (부분 병합하지 않고 통째로 교체한다).
# meaning_zone[0]은 core와 동일해야 한다 (Meaning Zone Rule 3).
#
# example_index는 그 블록의 examples 배열 안에서 1부터 시작하는 순번
# (1=declarative, 2=negative, 3=question)이다.
#
# 수정하지 않는 항목은 작성하지 않는다.
############################################################
ALL_REPLACEMENTS = {
"077": {
    "TITLE_REPLACEMENTS": {},
    "WORD_REPLACEMENTS": {
        ("block_001", "en"): {
            "core": "debate",
            "meaning_zone": ["debate", "discuss"]
        },
        ("block_002", "en"): {
            "core": "criticize",
            "meaning_zone": ["criticize", "fault"]
        },
        ("block_003", "en"): {
            "core": "justify",
            "meaning_zone": ["justify", "explain"]
        }
    },
    "EXAMPLE_REPLACEMENTS": {}
},
"144": {
    "TITLE_REPLACEMENTS": {},
    "WORD_REPLACEMENTS": {
        ("block_120", "target"): {
            "core": "recondite",
            "meaning_zone": ["recondite", "abstruse"]
        }
    },
    "EXAMPLE_REPLACEMENTS": {}
}
}
############################################################
# 현재 처리 중인 항목이 담기는 전역 변수
#
# validate_replacements(), apply_replacements()가
# 이 세 변수를 직접 참조하므로, process_one() 시작 시점에
# 매 배치마다 이 값을 갱신해야 한다.
############################################################
TITLE_REPLACEMENTS = {}
WORD_REPLACEMENTS = {}
EXAMPLE_REPLACEMENTS = {}

############################################################
# 교정(edit) 가능 언어 = target을 제외한 7개 언어.
#
# target 자체는 검수프롬프트 규칙상 절대 수정하지 않으므로
# 여기에 포함하지 않는다. 미러 언어(en 또는 kr)도 이 7개 안에
# 포함되어 있다 — 미러 언어를 고친다는 것은 "target과 다시
# 일치시킨다"는 뜻이지, target 자체를 바꾸는 게 아니기 때문이다.
############################################################
ALLOWED_LANGUAGES = {
    "en",
    "es",
    "fr",
    "pt",
    "kr",
    "jp",
    "zh",
}

############################################################
# Meaning Zone 구조 규칙 (Manual A Section 3.4) 중
# 스크립트로 기계적으로 검증 가능한 것만 여기서 강제한다.
#
#   MZ-1: 최대 3개
#   MZ-2: 최소 1개
#   MZ-3: meaning_zone[0] == core
#   MZ-7: 중복 표현 금지
#
# (같은 zone인지, 의미 확장/축소인지, 품사 이동인지는 의미
#  판단이 필요해서 이 스크립트가 아니라 검수프롬프트 단계에서
#  이미 걸러졌다고 가정한다.)
############################################################

def validate_meaning_zone(core, meaning_zone, key_repr: str) -> list[str]:
    errors: list[str] = []

    if not isinstance(core, str) or not core.strip():
        errors.append(
            f"[REPLACEMENT] core는 비어 있지 않은 문자열이어야 "
            f"합니다: {key_repr}"
        )
        return errors

    if not isinstance(meaning_zone, list):
        errors.append(
            f"[REPLACEMENT] meaning_zone은 배열이어야 합니다: {key_repr}"
        )
        return errors

    if len(meaning_zone) < 1:
        errors.append(
            f"[REPLACEMENT] meaning_zone은 최소 1개 이상이어야 "
            f"합니다: {key_repr}"
        )
        return errors

    if len(meaning_zone) > 3:
        errors.append(
            f"[REPLACEMENT] meaning_zone은 최대 3개까지만 허용됩니다 "
            f"(현재 {len(meaning_zone)}개): {key_repr}"
        )

    for item in meaning_zone:
        if not isinstance(item, str) or not item.strip():
            errors.append(
                f"[REPLACEMENT] meaning_zone의 각 항목은 비어 있지 "
                f"않은 문자열이어야 합니다: {key_repr}"
            )
            return errors

    if meaning_zone[0] != core:
        errors.append(
            f"[REPLACEMENT] meaning_zone[0]은 core와 완전히 동일해야 "
            f"합니다 (core={core!r}, meaning_zone[0]="
            f"{meaning_zone[0]!r}): {key_repr}"
        )

    if len(set(meaning_zone)) != len(meaning_zone):
        errors.append(
            f"[REPLACEMENT] meaning_zone에 중복된 표현이 있습니다: "
            f"{key_repr} {meaning_zone!r}"
        )

    return errors


############################################################
# 파일 경로 해석
############################################################

def resolve_json_file(argument: str) -> Path:
    """
    다음 입력을 모두 지원한다.

    resolve_json_file("003")
    resolve_json_file("data/003/data.json")
    resolve_json_file("/절대경로/data.json")
    """

    candidate = Path(argument).expanduser()

    if candidate.is_file():
        return candidate.resolve()

    if argument.isdigit():
        batch_id = argument.zfill(3)

        return DATA_DIR / batch_id / "data.json"

    return candidate.resolve()


############################################################
# block_id로 블록 찾기
############################################################

def find_block(data: dict, block_id: str):
    for block in data.get("blocks", []):
        if isinstance(block, dict) and block.get("id") == block_id:
            return block
    return None


############################################################
# 교체 설정 검증
############################################################

def validate_replacements(data: dict) -> list[str]:
    """
    TITLE_REPLACEMENTS / WORD_REPLACEMENTS / EXAMPLE_REPLACEMENTS에
    지정한 위치가 실제 JSON에 존재하는지, 형식이 스키마와 맞는지
    검사한다. 오류가 하나라도 있으면 JSON을 수정하지 않는다.
    """

    errors: list[str] = []

    if "title" not in data or not isinstance(data["title"], dict):
        errors.append("[REPLACEMENT] JSON에 유효한 title 객체가 없습니다.")

    if "blocks" not in data or not isinstance(data["blocks"], list):
        errors.append("[REPLACEMENT] JSON에 유효한 blocks 배열이 없습니다.")
        return errors

    ########################################################
    # title 검증
    ########################################################

    for lang, new_title in TITLE_REPLACEMENTS.items():
        if lang not in ALLOWED_LANGUAGES:
            errors.append(f"[REPLACEMENT] 허용되지 않은 제목 언어: {lang}")
            continue

        if lang not in data.get("title", {}):
            errors.append(f"[REPLACEMENT] title에 언어 키가 없습니다: {lang}")

        if not isinstance(new_title, str) or not new_title.strip():
            errors.append(
                f"[REPLACEMENT] 제목은 비어 있지 않은 문자열이어야 "
                f"합니다: {lang}"
            )

    ########################################################
    # word 검증 — value는 {"core": str, "meaning_zone": [str,...]}
    ########################################################

    for key, new_word in WORD_REPLACEMENTS.items():
        if not isinstance(key, tuple) or len(key) != 2:
            errors.append(
                f"[REPLACEMENT] 잘못된 WORD_REPLACEMENTS 키 형식: {key!r}"
            )
            continue

        block_id, lang = key

        if not isinstance(block_id, str):
            errors.append(
                f"[REPLACEMENT] block_id는 문자열이어야 합니다: {key!r}"
            )
            continue

        if lang == "target":
            errors.append(
                f"[REPLACEMENT] target 언어는 수정할 수 없습니다: {key!r}"
            )
            continue

        if lang not in ALLOWED_LANGUAGES:
            errors.append(
                f"[REPLACEMENT] 허용되지 않은 언어입니다: {lang} / {key!r}"
            )
            continue

        if not isinstance(new_word, dict):
            errors.append(
                f"[REPLACEMENT] word 교체값은 "
                f'{{"core": str, "meaning_zone": [str,...]}} 형태의 '
                f"객체여야 합니다: {key!r}"
            )
            continue

        if set(new_word.keys()) - {"core", "meaning_zone"}:
            errors.append(
                f"[REPLACEMENT] word 교체값에 core/meaning_zone 이외의 "
                f"키가 있습니다: {key!r} {sorted(new_word.keys())}"
            )

        core = new_word.get("core")
        meaning_zone = new_word.get("meaning_zone")

        errors.extend(validate_meaning_zone(core, meaning_zone, repr(key)))

        block = find_block(data, block_id)
        if block is None:
            errors.append(f"[REPLACEMENT] 존재하지 않는 block_id입니다: {block_id}")
            continue

        word = block.get("word")
        if not isinstance(word, dict):
            errors.append(f"[REPLACEMENT] word 객체가 없습니다: {block_id}")
            continue

        if lang not in word:
            errors.append(
                f"[REPLACEMENT] word에 언어 키가 없습니다: {block_id} [{lang}]"
            )

    ########################################################
    # example 검증 — value는 그냥 문자열
    ########################################################

    for key, new_text in EXAMPLE_REPLACEMENTS.items():
        if not isinstance(key, tuple) or len(key) != 3:
            errors.append(
                f"[REPLACEMENT] 잘못된 EXAMPLE_REPLACEMENTS 키 형식: {key!r}"
            )
            continue

        block_id, example_index, lang = key

        if not isinstance(block_id, str):
            errors.append(
                f"[REPLACEMENT] block_id는 문자열이어야 합니다: {key!r}"
            )
            continue

        if not isinstance(example_index, int) or example_index < 1:
            errors.append(
                f"[REPLACEMENT] example_index는 1 이상의 정수여야 "
                f"합니다: {key!r}"
            )
            continue

        if example_index > 3:
            errors.append(
                f"[REPLACEMENT] example_index는 1~3 범위여야 합니다 "
                f"(블록당 예문 3개 고정): {key!r}"
            )

        if lang == "target":
            errors.append(
                f"[REPLACEMENT] target 언어는 수정할 수 없습니다: {key!r}"
            )
            continue

        if lang not in ALLOWED_LANGUAGES:
            errors.append(
                f"[REPLACEMENT] 허용되지 않은 언어입니다: {lang} / {key!r}"
            )
            continue

        if not isinstance(new_text, str) or not new_text.strip():
            errors.append(
                f"[REPLACEMENT] 교체 예문은 비어 있지 않은 "
                f"문자열이어야 합니다: {key!r}"
            )
            continue

        block = find_block(data, block_id)
        if block is None:
            errors.append(f"[REPLACEMENT] 존재하지 않는 block_id입니다: {block_id}")
            continue

        examples = block.get("examples")
        if not isinstance(examples, list):
            errors.append(f"[REPLACEMENT] examples 배열이 없습니다: {block_id}")
            continue

        if example_index > len(examples):
            errors.append(
                f"[REPLACEMENT] 존재하지 않는 example입니다: "
                f"{block_id} example {example_index} "
                f"(실제 example 수: {len(examples)})"
            )
            continue

        example = examples[example_index - 1]
        if not isinstance(example, dict):
            errors.append(
                f"[REPLACEMENT] 유효하지 않은 example 객체입니다: "
                f"{block_id} example {example_index}"
            )
            continue

        if lang not in example:
            errors.append(
                f"[REPLACEMENT] example에 언어 키가 없습니다: "
                f"{block_id} example {example_index} [{lang}]"
            )

    return errors


############################################################
# 교체 적용
############################################################

def apply_replacements(data: dict) -> tuple[list[str], int, int]:
    """
    복사된 JSON 데이터에 교체값을 적용한다.

    반환값:
    - 출력 로그
    - 변경 수
    - 이미 동일한 항목 수
    """

    logs: list[str] = []
    changed = 0
    unchanged = 0

    ########################################################
    # 제목 수정
    ########################################################

    for lang, new_text in TITLE_REPLACEMENTS.items():
        old_text = data["title"].get(lang)

        if old_text == new_text:
            unchanged += 1
            logs.append(f"Unchanged Title [{lang}]: {new_text}")
            continue

        data["title"][lang] = new_text
        changed += 1

        logs.append(f"Updated Title [{lang}]")
        logs.append(f"  Old: {old_text!r}")
        logs.append(f"  New: {new_text}")

    ########################################################
    # word 수정 — {core, meaning_zone} 객체를 통째로 교체
    ########################################################

    for (block_id, lang), new_word in WORD_REPLACEMENTS.items():
        block = find_block(data, block_id)
        old_word = block["word"].get(lang)

        new_value = {
            "core": new_word["core"],
            "meaning_zone": list(new_word["meaning_zone"]),
        }

        if old_word == new_value:
            unchanged += 1
            logs.append(f"Unchanged Word [{block_id}] [{lang}]: {new_value}")
            continue

        block["word"][lang] = new_value
        changed += 1

        logs.append(f"Updated Word [{block_id}] [{lang}]")
        logs.append(f"  Old: {old_word!r}")
        logs.append(f"  New: {new_value!r}")

    ########################################################
    # example 수정
    ########################################################

    for (
        block_id,
        example_index,
        lang,
    ), new_text in EXAMPLE_REPLACEMENTS.items():
        block = find_block(data, block_id)
        example = block["examples"][example_index - 1]
        old_text = example.get(lang)

        if old_text == new_text:
            unchanged += 1
            logs.append(
                f"Unchanged Example [{block_id}] [{example_index}] [{lang}]"
            )
            continue

        example[lang] = new_text
        changed += 1

        logs.append(
            f"Updated Example [{block_id}] [{example_index}] [{lang}]"
        )
        logs.append(f"  Old: {old_text!r}")
        logs.append(f"  New: {new_text}")

    return logs, changed, unchanged


############################################################
# 안전한 파일 저장
############################################################

def write_json_safely(json_file: Path, data) -> None:
    """
    임시 파일에 먼저 저장한 후 원본 파일을 교체한다.
    저장 중 오류가 발생해도 기존 JSON이 훼손되지 않는다.
    """

    temporary_file = json_file.with_suffix(json_file.suffix + ".tmp")

    try:
        with open(temporary_file, "w", encoding="utf-8") as file:
            json.dump(data, file, ensure_ascii=False, indent=2)
            file.write("\n")

        temporary_file.replace(json_file)

    except OSError:
        if temporary_file.exists():
            try:
                temporary_file.unlink()
            except OSError:
                pass

        raise


############################################################
# 배치 1건 처리
#
# 반환값: 성공 여부 (True/False)
############################################################

def process_one(batch_id: str, replacement: dict) -> bool:
    global TITLE_REPLACEMENTS, WORD_REPLACEMENTS, EXAMPLE_REPLACEMENTS

    TITLE_REPLACEMENTS = replacement.get("TITLE_REPLACEMENTS", {})
    WORD_REPLACEMENTS = replacement.get("WORD_REPLACEMENTS", {})
    EXAMPLE_REPLACEMENTS = replacement.get("EXAMPLE_REPLACEMENTS", {})

    print("=" * 80)
    print(f"[{batch_id}] 처리 시작")
    print("=" * 80)

    json_file = resolve_json_file(batch_id)

    ########################################################
    # 파일 존재 여부
    ########################################################

    if not json_file.exists():
        print(f"File not found: {json_file}")
        return False

    if not json_file.is_file():
        print(f"Not a file: {json_file}")
        return False

    ########################################################
    # JSON 읽기
    ########################################################

    try:
        with open(json_file, "r", encoding="utf-8") as file:
            original_data = json.load(file)

    except json.JSONDecodeError as exc:
        print(f"Invalid JSON: {json_file}")
        print(f"Line {exc.lineno}, column {exc.colno}: {exc.msg}")
        return False

    except OSError as exc:
        print(f"Could not read file: {exc}")
        return False

    ########################################################
    # 교체 설정 검사
    ########################################################

    replacement_errors = validate_replacements(original_data)

    if replacement_errors:
        print("Validation failed.")
        print("JSON was not modified.")
        print()

        for error in replacement_errors:
            print(f"- {error}")

        return False

    ########################################################
    # 수정 사항 확인
    ########################################################

    if (
        not TITLE_REPLACEMENTS
        and not WORD_REPLACEMENTS
        and not EXAMPLE_REPLACEMENTS
    ):
        print("No replacements configured.")
        print("JSON was not modified.")
        return True

    ########################################################
    # 원본을 직접 수정하지 않고 복사본에 적용
    ########################################################

    updated_data = copy.deepcopy(original_data)

    logs, changed, unchanged = apply_replacements(updated_data)

    print(f"File: {json_file}")
    print()

    for log in logs:
        print(log)

    ########################################################
    # 실제 변경이 없으면 저장하지 않음
    ########################################################

    if changed == 0:
        print()
        print("No actual changes.")
        print("JSON was not rewritten.")
        print(f"Already identical: {unchanged}")
        return True

    ########################################################
    # 저장
    ########################################################

    try:
        write_json_safely(json_file, updated_data)

    except OSError as exc:
        print()
        print(f"Could not write file: {exc}")
        return False

    print()
    print("Done.")
    print(f"Changed: {changed}")
    print(f"Already identical: {unchanged}")

    return True


############################################################
# 메인
#
# ALL_REPLACEMENTS에 등록된 항목을 batch_id 순서대로
# 하나씩 process_one()에 넘겨서 처리한다.
#
# 인자 없이 "python3 voca_review.py" 한 번 실행으로
# ALL_REPLACEMENTS 전체가 처리된다.
############################################################

def main() -> None:
    if not ALL_REPLACEMENTS:
        print("No replacements configured.")
        print("ALL_REPLACEMENTS가 비어 있습니다.")
        return

    success_ids: list[str] = []
    failed_ids: list[str] = []

    for batch_id in sorted(ALL_REPLACEMENTS):
        replacement = ALL_REPLACEMENTS[batch_id]
        ok = process_one(batch_id, replacement)

        if ok:
            success_ids.append(batch_id)
        else:
            failed_ids.append(batch_id)

        print()

    print("=" * 80)
    print("ALL FILES COMPLETED")
    print("=" * 80)
    print(f"Success: {len(success_ids)}")
    print(f"Failed:  {len(failed_ids)}")

    if failed_ids:
        print()
        print("실패한 batch_id 목록:")
        for batch_id in failed_ids:
            print(f"  - {batch_id}")

        sys.exit(1)


if __name__ == "__main__":
    main()