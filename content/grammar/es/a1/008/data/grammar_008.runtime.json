  "title": {
    "target": "-아요/어요",
    "en": "-아요/어요 (Polite Present Tense)",
    "es": "-아요/어요 (Presente formal)",
    "fr": "-아요/어요 (Présent poli)",
    "pt": "-아요/어요 (Presente formal)"
  },
  "blocks": [
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "'-아요/어요'는 현재 시제의 기본 존댓말 어미이다.",
        "en": "‘-아요/어요’ is the basic polite ending for the present tense.",
        "es": "«-아요/어요» es la terminación formal básica del presente.",
        "fr": "« -아요/어요 » est la terminaison polie de base au présent.",
        "pt": "«-아요/어요» é a terminação formal básica do presente."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "동사의 마지막 모음에 따라 '-아요' 또는 '-어요'를 쓴다.",
        "en": "Use ‘-아요’ or ‘-어요’ depending on the last vowel of the verb.",
        "es": "Se usa «-아요» o «-어요» según la última vocal del verbo.",
        "fr": "On utilise « -아요 » ou « -어요 » selon la dernière voyelle du verbe.",
        "pt": "Usa-se «-아요» ou «-어요» dependendo da última vogal do verbo."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "ㅏ, ㅗ로 끝나는 동사에는 '-아요'를 붙인다.",
        "en": "If the verb ends in ㅏ or ㅗ, attach ‘-아요’.",
        "es": "Si el verbo termina en ㅏ o ㅗ, se usa «-아요».",
        "fr": "Si le verbe se termine par ㅏ ou ㅗ, on utilise « -아요 ».",
        "pt": "Se o verbo termina em ㅏ ou ㅗ, usa-se «-아요»."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "그 외의 모음에는 '-어요'를 붙인다.",
        "en": "For all other vowels, attach ‘-어요’.",
        "es": "Para las demás vocales, se usa «-어요».",
        "fr": "Pour les autres voyelles, on utilise « -어요 ».",
        "pt": "Para as outras vogais, usa-se «-어요»."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "하다 동사는 '해요'로 변한다.",
        "en": "하다 verbs change to ‘해요’.",
        "es": "Los verbos con 하다 cambian a «해요».",
        "fr": "Les verbes en 하다 deviennent « 해요 ».",
        "pt": "Os verbos com 하다 tornam-se «해요»."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "존댓말 문장을 만들 때 가장 많이 쓰는 형태이다.",
        "en": "It is one of the most commonly used polite forms.",
        "es": "Es una de las formas formales más utilizadas.",
        "fr": "C’est l’une des formes polies les plus utilisées.",
        "pt": "É uma das formas formais mais usadas."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "친절하고 부드러운 느낌을 준다.",
        "en": "It gives a kind and soft feeling.",
        "es": "Da una sensación amable y suave.",
        "fr": "Elle donne une impression douce et polie.",
        "pt": "Dá uma sensação educada e suave."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "일상 대화에서 매우 자주 등장한다.",
        "en": "It appears very often in daily conversations.",
        "es": "Aparece muy a menudo en conversaciones diarias.",
        "fr": "Elle apparaît très souvent dans les conversations quotidiennes.",
        "pt": "Surge muitas vezes nas conversas do dia a dia."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "현재 상태나 습관을 말할 때 사용한다.",
        "en": "It is used to talk about present actions or habits.",
        "es": "Se usa para hablar de acciones presentes o hábitos.",
        "fr": "Elle s’emploie pour parler d’actions présentes ou d’habitudes.",
        "pt": "Usa-se para falar de ações presentes ou hábitos."
      }
    },
    {
      "type": "grammar_explanation",
      "sentences": {
        "target": "명령이나 청유 표현에서는 보통 쓰이지 않는다.",
        "en": "It is not usually used in commands or suggestions.",
        "es": "Normalmente no se usa en órdenes o sugerencias.",
        "fr": "Elle n’est généralement pas utilisée pour les ordres ou les suggestions.",
        "pt": "Normalmente não é usada em ordens ou sugestões."
      }
    },
